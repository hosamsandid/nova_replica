#!/usr/bin/env python3
"""aee-emit — DEPRECATED compatibility shim (#2578). Apply the label on GitHub instead.

The internal-channel hand-off this command used to announce was removed: every
label hand-off is now an ordinary GitHub label, and the GitHub poller wakes
every matching listener. Prompts of teams created before that change may still
say to run `aee-emit`, so for one release this command keeps its old surface
and simply applies the label on the issue / pull request — exactly what you
should do directly:

    gh issue edit 42 --add-label ready        # instead of: aee-emit ready --issue 42
    gh pr edit 7 --add-label qa:approved      # instead of: aee-emit qa:approved --pr 7

Usage (unchanged):

    aee-emit <label> (--issue <n> | --pr <n>) [--repo <clone-dir>] [--json]

A label that does not exist on the repository yet is created, then applied.
This shim will be removed in a later release.

Exit codes (shared CLI contract, docs/cli-contract.md): 0 ok · 1 domain error
(GitHub refused the label) · 2 usage error.
"""

import json
import os
import subprocess
import sys

EXIT_OK = 0
EXIT_DOMAIN = 1
EXIT_USAGE = 2

DEPRECATION = ("aee-emit is deprecated (#2578) — label hand-offs are plain GitHub "
               "labels now; use `gh issue|pr edit <n> --add-label <label>` directly.")

_AS_JSON = False


def die(msg: str, code: int = EXIT_USAGE):
    if _AS_JSON:
        sys.stdout.write(json.dumps({"ok": False, "error": msg}) + "\n")
    else:
        sys.stderr.write(f"aee-emit: {msg}\n")
    sys.exit(code)


def usage():
    die("usage: aee-emit <label> (--issue <n> | --pr <n>) [--repo <clone-dir>] [--json]")


def resolve_repo_full_name(clone_dir):
    """owner/name from the clone's origin remote (host-agnostic)."""
    cmd = ["git"]
    if clone_dir:
        if not os.path.isdir(clone_dir):
            die(f"--repo '{clone_dir}': no such directory (expected a clone dir)")
        cmd += ["-C", clone_dir]
    cmd += ["remote", "get-url", "origin"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        where = clone_dir or "the current directory"
        die(f"cannot read the origin remote of {where}: {(r.stderr or '').strip()}")
    url = r.stdout.strip()
    tail = url.replace(":", "/").rstrip("/")
    if tail.endswith(".git"):
        tail = tail[: -len(".git")]
    parts = [p for p in tail.split("/") if p]
    if len(parts) < 2:
        die(f"cannot derive owner/name from origin URL '{url}'")
    return f"{parts[-2]}/{parts[-1]}"


def gh(args):
    try:
        return subprocess.run(["gh", *args], capture_output=True, text=True)
    except FileNotFoundError:
        die("the `gh` CLI is not available", EXIT_DOMAIN)


def main(argv):
    global _AS_JSON
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return
    label = kind = number = clone_dir = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            _AS_JSON = True
        elif a in ("--issue", "--pr"):
            if kind is not None:
                die("pass exactly one of --issue / --pr")
            i += 1
            if i >= len(argv):
                usage()
            kind = "issue" if a == "--issue" else "pr"
            try:
                number = int(argv[i])
            except ValueError:
                die(f"{a} expects a number, got '{argv[i]}'")
        elif a == "--repo":
            i += 1
            if i >= len(argv):
                usage()
            clone_dir = argv[i]
        elif a.startswith("-"):
            usage()
        elif label is None:
            label = a
        else:
            usage()
        i += 1
    if not label or kind is None or number is None or number <= 0:
        usage()

    sys.stderr.write(f"aee-emit: {DEPRECATION}\n")
    repo = resolve_repo_full_name(clone_dir)
    edit = [kind, "edit", str(number), "--add-label", label, "-R", repo]
    r = gh(edit)
    created = False
    if r.returncode != 0:
        # Most likely the label does not exist yet — create it, then retry once.
        c = gh(["label", "create", label, "--color", "FBCA04",
                "--description", "flow hand-off label", "-R", repo])
        created = c.returncode == 0
        r = gh(edit)
    ref = f"{repo}#{number}"
    if r.returncode != 0:
        die(f"could not apply '{label}' on {ref}: {(r.stderr or r.stdout or '').strip()}", EXIT_DOMAIN)
    if _AS_JSON:
        sys.stdout.write(json.dumps({
            "ok": True, "label": label, "ref": ref, "labelCreated": created,
            "deprecated": True,
        }) + "\n")
        return
    print(f"aee-emit: applied '{label}' on {ref} — the GitHub poller wakes its listeners.")


if __name__ == "__main__":
    main(sys.argv[1:])
