#!/usr/bin/env python3
"""aee-gh — the `gh` on an agent's PATH (#2559). Transparent wrapper around the
real GitHub CLI; agents keep typing `gh …`.

What it changes: during a LIVE CHAT TURN (the runtime sets `AEE_ACTING_SENDER`
to the human who sent the message) an issue, pull-request or label WRITE —
`gh issue create/comment/edit/close/…`, `gh pr create/comment/review/edit/
merge/…`, `gh label create/edit/delete/clone`, `gh api` with a writing method
(FORWARD_COMMANDS below) — is not run with the container's baked `GH_TOKEN` (the team's
baseline identity) but forwarded to the orchestrator, which runs it under the
chat sender's own personal GitHub token. That token never enters the container.

  * Sender has a personal token      → the write appears on GitHub as theirs.
  * Sender has none / it is orphaned → refused with the same "personal
                                       credential required" message as
                                       `gh-as-agent push`/`pr`. Nothing is
                                       written; there is no fallback to the
                                       team's identity.
  * Sender not trusted / unknown     → runs locally under the baseline, as before.

Everything else runs the real `gh` locally, byte-for-byte as before: every
autonomous run (cron, GitHub event, loop, hand-off — no `AEE_ACTING_SENDER`),
every read (`view`, `list`, `status`, `diff`, `checks`, `gh api` GETs, …),
local-only commands (`auth`, `config`, `alias`, `extension`, …) and the other
write groups (`release`, `gist`, `repo`, `secret`, `variable`, `workflow`,
`run`, …), which keep the container's identity and their stdin.

Forwarded commands run without your checkout: the repository is passed from
`-R/--repo`, `GH_REPO` or the current directory's `origin` remote, files named
by `-F/--body-file`, `--attach`, `--recover`, `gh api --input` and
`gh api -F key=@file` (or `-` for stdin) are sent along, and `gh pr create`
gets `--head <current branch>` unless you gave one. The orchestrator accepts
only each command's known options (no `--editor`/`--web`, no
`gh api --hostname`); anything else is refused and nothing is written. Name
PRs/issues by number — a forwarded `gh pr comment` without one cannot see your
current branch.

Signed commits (#2938): when `gh pr merge` / `gh pr update-branch` fails because
GitHub requires signed commits and the PR holds unsigned ones, the shim adds one
actionable message after gh's own error (cause, the credential scope that lacks
a signing key, affected commits, fix) — from the orchestrator's `unsigned-hint`
route, or a generic version when it cannot be reached. A forwarded chat-turn
merge gets the same message from the orchestrator. gh's exit code is kept.

Exit codes: the real `gh`'s own code for a command that ran · 1 when the write
was refused or could not be forwarded (nothing was written).
"""

import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

ORCH = (os.environ.get("ORCHESTRATOR_INTERNAL_URL")
        or os.environ.get("AEE_ORCHESTRATOR_URL")
        or "http://orchestrator:4002").rstrip("/")
TIMEOUT_SEC = 90

# The `group verb` commands the orchestrator runs for a chat turn (kept in step
# with COMMAND_SPECS in orchestrator/chat-github-write.js, which also
# allowlists each command's options), plus every writing `gh api` call. Any
# other command — reads, local-only groups (auth, config, alias, extension, …)
# and writes the orchestrator does not run for a chat turn (release, gist,
# repo, secret, variable, workflow, run, …) — runs the real `gh` locally.
FORWARD_COMMANDS = {
    "issue create", "issue edit", "issue comment", "issue close", "issue reopen",
    "issue delete", "issue lock", "issue unlock", "issue transfer", "issue pin",
    "issue unpin",
    "pr create", "pr comment", "pr review", "pr edit", "pr close", "pr reopen",
    "pr merge", "pr ready", "pr update-branch", "pr revert", "pr lock", "pr unlock",
    "label create", "label edit", "label delete", "label clone",
}

# Flags whose value is a local file the forwarded command must carry along.
# `-F` means `--body-file` everywhere except `gh api`, where it is a field.
BODY_FILE_FLAGS = {"--body-file", "-F", "--attach", "--recover"}
API_FILE_FLAGS = {"--input"}
API_FIELD_FLAGS = {"-F", "--field"}
API_RAW_FIELD_FLAGS = {"-f", "--raw-field"}
API_METHOD_FLAGS = {"-X", "--method"}


# `gh` commands whose server-side rejection over unsigned commits gets the
# actionable message (orchestrator/commit-signing.js GH_UNSIGNED_OPERATIONS).
UNSIGNED_HINT_COMMANDS = {"pr merge": "merge", "pr update-branch": "update-branch"}
# Mirror of commit-signing.js UNSIGNED_PATTERNS — only a match asks the
# orchestrator for the message.
UNSIGNED_PATTERNS = [
    re.compile(p, re.I) for p in (
        r"commits? must have (?:verified|valid) signatures?",
        r"must have a verified signature",
        r"requires? signed commits",
        r"required signatures?",
        r"unverified commits?",
        r"unsigned commits?",
    )
]
UNSIGNED_FALLBACK = (
    "GitHub rejected this {operation}: this GitHub instance requires signed commits and this pull "
    "request contains unsigned ones (typically pushed before enforcement).\n"
    "How to fix:\n"
    "1. In Agent Studio, open Credentials → SSH Keys (/ssh-keys) and add or generate a signing key "
    "(personal, team or global) with the commit name and email it signs as.\n"
    "2. On GitHub, upload its public key as type \"Signing Key\" to the account whose VERIFIED email "
    "is that commit email.\n"
    "3. Re-sign the PR's commits in a new run, e.g. `git rebase --force-rebase <base-branch>`, and push "
    "them to a new branch rather than force-pushing over review history."
)


def _internal_headers(extra=None):
    # Internal-API credential (#1456) — duplicated per CLI by contract
    # (docs/cli-contract.md §4.5, dependency-free single files).
    headers = dict(extra or {})
    token = os.environ.get("AEE_INTERNAL_TOKEN")
    if token:
        headers["Authorization"] = "Bearer " + token
    return headers


def real_gh() -> str:
    """The real GitHub CLI: `AEE_REAL_GH`, else the first `gh` on PATH that is
    not this script."""
    explicit = os.environ.get("AEE_REAL_GH")
    if explicit:
        return explicit
    me = os.path.realpath(__file__)
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d or ".", "gh")
        if os.path.isfile(cand) and os.access(cand, os.X_OK) and os.path.realpath(cand) != me:
            return cand
    return "/usr/bin/gh"


def _flag_value(args, i):
    """(`flag`, `value`, `value_index`, `next_i`) for the option at args[i],
    supporting both `--flag value` and `--flag=value`."""
    a = args[i]
    if a.startswith("--") and "=" in a:
        flag, value = a.split("=", 1)
        return flag, value, i, i + 1
    if i + 1 < len(args):
        return a, args[i + 1], i + 1, i + 2
    return a, None, None, i + 1


def _read_maybe_file(value: str, stdin_data: bytes | None) -> str:
    if value == "-":
        return (stdin_data or b"").decode("utf-8", "replace")
    try:
        with open(value, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def api_is_write(args, stdin_data=None) -> bool:
    """Whether a `gh api …` invocation (args WITHOUT the leading "api") writes.

    Mirrors gh's own defaulting: an explicit -X/--method decides; otherwise any
    field / --input makes it a POST. A GraphQL call is a write when its query is
    a `mutation`, and an unreadable query is treated as a write (fail closed —
    it is then forwarded, never silently run under the baseline)."""
    method = None
    has_body = False
    endpoint = None
    query_texts = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in API_METHOD_FLAGS or a.startswith("--method="):
            _, value, _, i = _flag_value(args, i)
            method = (value or "").upper()
            continue
        if a.startswith("-X") and len(a) > 2:
            method = a[2:].upper()
            i += 1
            continue
        if a in API_FIELD_FLAGS or a in API_RAW_FIELD_FLAGS or a in API_FILE_FLAGS \
                or a.startswith(("--field=", "--raw-field=", "--input=")):
            flag, value, _, i = _flag_value(args, i)
            has_body = True
            value = value or ""
            if value.startswith("query="):
                q = value[len("query="):]
                if q.startswith("@") and flag not in API_RAW_FIELD_FLAGS:
                    q = _read_maybe_file(q[1:], stdin_data)
                query_texts.append(q)
            continue
        if a.startswith("-"):
            # Other options (-H, --jq, -q, --paginate, …) — skip a value that
            # obviously belongs to them.
            if a in {"-H", "--header", "-q", "--jq", "-t", "--template",
                     "--hostname", "--cache", "-p", "--preview"} and i + 1 < len(args):
                i += 2
            else:
                i += 1
            continue
        if endpoint is None:
            endpoint = a
        i += 1
    if endpoint == "graphql":
        if not query_texts:
            return True
        return any(re.search(r"^\s*mutation\b", q) for q in query_texts)
    if method:
        return method not in ("GET", "HEAD")
    return has_body


def is_forwarded_write(args, stdin_data=None) -> bool:
    """Whether this `gh` invocation is a GitHub write the chat-turn path forwards."""
    if not args or args[0].startswith("-"):
        return False
    if any(a in ("-h", "--help") for a in args[1:]):
        return False
    if args[0] == "api":
        return api_is_write(args[1:], stdin_data)
    return len(args) > 1 and f"{args[0]} {args[1]}" in FORWARD_COMMANDS


def _file_refs(args):
    """(`index`, `prefix`, `path`) for every argument that names a local file.
    Expects `_normalise`d args (each flag and its value in separate slots)."""
    is_api = bool(args) and args[0] == "api"
    refs = []
    i = 1
    while i < len(args) - 1:
        a, v = args[i], args[i + 1]
        if is_api and a in API_FILE_FLAGS:
            refs.append((i + 1, "", v))
        elif is_api and a in API_FIELD_FLAGS and v.partition("=")[2].startswith("@"):
            # gh splits a field at the FIRST `=`; only then does `@` mean a file.
            key, _, value = v.partition("=")
            refs.append((i + 1, f"{key}=@", value[1:]))
        elif not is_api and a in BODY_FILE_FLAGS:
            refs.append((i + 1, "", v))
        else:
            i += 1
            continue
        i += 2
    return refs


def _needs_stdin(args) -> bool:
    return any(path == "-" for _, _, path in _file_refs(args))


def collect_files(args, stdin_data=None):
    """The `files` list for the forward request: every argument that names a
    local file, with its content (base64) and the prefix to keep."""
    files = []
    for index, prefix, path in _file_refs(args):
        if path == "-":
            data = stdin_data or b""
        else:
            with open(path, "rb") as fh:
                data = fh.read()
        files.append({"index": index, "prefix": prefix,
                      "content": base64.b64encode(data).decode("ascii")})
    return files


def _normalise(args):
    """Split `--flag=value` for the file-carrying flags into `--flag value`, and
    an attached `-Fvalue` / `-XMETHOD` into two arguments, so every file
    reference occupies exactly one argument slot (the orchestrator refuses the
    attached forms)."""
    out = []
    for a in args:
        if a.startswith("--") and "=" in a:
            flag, value = a.split("=", 1)
            if flag in BODY_FILE_FLAGS | API_FILE_FLAGS | API_FIELD_FLAGS:
                out.extend([flag, value])
                continue
        elif a[:2] in ("-F", "-X") and len(a) > 2:
            out.extend([a[:2], a[2:]])
            continue
        out.append(a)
    return out


def _with_head(args):
    """A forwarded `gh pr create` cannot see the checkout, so name the current
    branch as `--head` unless the agent already did."""
    if args[:2] != ["pr", "create"] or any(
            a in ("-H", "--head") or a.startswith("--head=") for a in args):
        return args
    try:
        branch = subprocess.run(["git", "branch", "--show-current"], capture_output=True,
                                text=True, timeout=10).stdout.strip()
    except Exception:
        branch = ""
    return [*args, "--head", branch] if branch else args


def _repo_from_args(args):
    for i, a in enumerate(args):
        if a in ("-R", "--repo") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--repo="):
            return a.split("=", 1)[1]
    return None


def _repo_from_remote_url(url: str):
    url = url.strip()
    m = re.match(r"^(?:ssh://)?git@([^:/]+)[:/](.+?)(?:\.git)?/?$", url) \
        or re.match(r"^https?://(?:[^@/]+@)?([^/]+)/(.+?)(?:\.git)?/?$", url)
    if not m:
        return None
    host, path = m.group(1), m.group(2)
    if path.count("/") != 1:
        return None
    return path if host in ("github.com", "ssh.github.com") else f"{host}/{path}"


def current_repo(args):
    """`[HOST/]OWNER/REPO` the forwarded command targets, or None."""
    if _repo_from_args(args):
        return None  # -R travels in argv already
    if os.environ.get("GH_REPO"):
        return os.environ["GH_REPO"]
    try:
        url = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True,
                             text=True, timeout=10).stdout
    except Exception:
        return None
    return _repo_from_remote_url(url) if url else None


def unsigned_hint_operation(args):
    """'merge' / 'update-branch' for `gh pr merge` / `gh pr update-branch`."""
    return UNSIGNED_HINT_COMMANDS.get(" ".join(args[:2])) if len(args) >= 2 else None


def is_unsigned_rejection(text: str) -> bool:
    return any(p.search(text or "") for p in UNSIGNED_PATTERNS)


def unsigned_hint(operation: str, detail: str) -> str:
    """The orchestrator's message for this agent (names the credential scope
    and the affected commits), else the generic fallback."""
    agent_id = os.environ.get("AGENT_ID", "")
    if agent_id:
        req = urllib.request.Request(
            f"{ORCH}/internal/agents/{urllib.request.quote(agent_id, safe='')}/git/unsigned-hint",
            data=json.dumps({"operation": operation, "detail": detail[-65536:],
                             "actingSender": (os.environ.get("AEE_ACTING_SENDER") or "").strip()}).encode("utf-8"),
            headers=_internal_headers({"Content-Type": "application/json"}),
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                message = json.loads(resp.read().decode("utf-8")).get("message")
            if message:
                return message
        except Exception:
            pass
    return UNSIGNED_FALLBACK.format(operation=operation)


def run_local(args, stdin_data=None):
    gh = real_gh()
    operation = unsigned_hint_operation(_normalise(list(args)))
    if operation:
        # stderr is captured (and passed through) so a rejection over unsigned
        # commits can be explained; stdout and stdin stay the caller's.
        proc = subprocess.run([gh, *args], input=stdin_data, stderr=subprocess.PIPE)
        err = proc.stderr.decode("utf-8", "replace")
        sys.stderr.write(err)
        if proc.returncode != 0 and is_unsigned_rejection(err):
            sys.stderr.write(("" if err.endswith("\n") else "\n") + "\n" + unsigned_hint(operation, err) + "\n")
        sys.stderr.flush()
        sys.exit(proc.returncode)
    if stdin_data is None:
        os.execv(gh, [gh, *args])
    proc = subprocess.run([gh, *args], input=stdin_data)
    sys.exit(proc.returncode)


def forward(args, sender, stdin_data):
    agent_id = os.environ.get("AGENT_ID", "")
    if not agent_id:
        return None  # not inside an agent container — nothing to forward to
    try:
        files = collect_files(args, stdin_data)
    except OSError as exc:
        sys.stderr.write(f"gh: {exc}\n")
        sys.exit(1)
    payload = {"args": args, "files": files, "actingSender": sender}
    repo = current_repo(args)
    if repo:
        payload["repo"] = repo
    req = urllib.request.Request(
        f"{ORCH}/internal/agents/{urllib.request.quote(agent_id, safe='')}/github/gh",
        data=json.dumps(payload).encode("utf-8"),
        headers=_internal_headers({"Content-Type": "application/json"}),
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try:
            data = json.loads(exc.read().decode("utf-8", "replace"))
        except Exception:
            data = {}
        msg = data.get("error") or f"HTTP {exc.code}"
        code = data.get("code")
        sys.stderr.write(
            f"gh: this GitHub write was NOT carried out"
            f"{f' ({code})' if code else ''}: {msg}\n")
        sys.exit(1)
    except Exception as exc:
        sys.stderr.write(
            f"gh: could not reach the orchestrator to run this GitHub write under the "
            f"chat sender's credential ({exc}). Nothing was written.\n")
        sys.exit(1)


def main(argv):
    sender = (os.environ.get("AEE_ACTING_SENDER") or "").strip()
    if not sender:
        run_local(argv)  # autonomous run / plain shell — unchanged behaviour
    args = _normalise(list(argv))
    stdin_data = sys.stdin.buffer.read() if _needs_stdin(args) else None
    if not is_forwarded_write(args, stdin_data):
        run_local(argv, stdin_data)
    result = forward(_with_head(args), sender, stdin_data)
    if not result or result.get("mode") == "baseline":
        run_local(argv, stdin_data)
    sys.stdout.write(result.get("stdout") or "")
    sys.stderr.write(result.get("stderr") or "")
    sys.exit(int(result.get("exitCode") or 0))


if __name__ == "__main__":
    main(sys.argv[1:])
