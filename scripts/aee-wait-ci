#!/usr/bin/env python3
"""aee-wait-ci — wait, inside this turn, until a pull request's CI has finished
and report green / red / merge conflict (#2796).

    aee-wait-ci <pr> [--repo <name>] [--timeout <minutes>] [--head <sha>] [--no-conflict-check]

Blocks in the FOREGROUND, re-reading the PR's head commit every few seconds,
until a verdict is reached or the timeout runs out, then prints ONE JSON
object on stdout and exits with a code that names the verdict. Use it when you
need to know, before you continue in this same turn, whether your PR is green
or conflicting. Never wrap it (or any CI wait) in a background shell or Task:
background work is killed when your turn ends.

Give the Bash tool call an explicit timeout of the wait plus 5 minutes
(1500000 ms for the default 20 minutes, at most 3300000): the tool's own
default stays at 2 minutes (#2815) and would move the wait to the background.

Arguments:
  <pr>                    the pull request: a number (`123`, `#123`) or its URL
  --repo <name>           the repository: a clone directory in your workspace
                          (e.g. `314092_my-repo`) or `owner/name`. Default: the
                          git repo of the current directory, else the only
                          clone in your workspace
  --timeout <minutes>     how long to wait (default 20). Capped so the wait
                          always ends before your run's own timeout
  --head <sha>            the commit you expect CI to run on (a full SHA, or a
                          revision of your local clone such as `HEAD`). Default:
                          your local HEAD when your clone is on the PR's branch
  --no-conflict-check     do not wait for / report merge conflicts — CI only
  --json                  accepted for the shared CLI contract; the result is
                          always JSON

Verdict rules (the SAME rules the platform's PR-readiness events and hand-off
readiness gate use — one shared definition, pr-readiness-rules.json):
  * every check run AND commit status on the head commit counts, required or
    not (CodeQL included);
  * one failing check settles `failed` at once, even while others still run;
  * no check at all after the grace period (3 min from when the head commit
    was first seen) means the PR has no CI → `no-ci`;
  * GitHub's `mergeable=UNKNOWN` (still computing) is re-read, never guessed.
A conflict is reported as soon as it is seen (a rebase is needed before CI
means anything). A push that moves the PR's head during the wait restarts the
evaluation on the new commit; `headSha` always names the commit the verdict
belongs to and `supersededHeads` lists the ones left behind.

Right after a push, GitHub can still show the previous commit as the PR's head
for a few seconds (#2818). While the PR's head is not the expected commit
(`--head`, or your local HEAD when your clone is on the PR's branch), nothing
is reported for the old head — not its red CI, not its conflict — and the PR
is re-read every few seconds. With the local-HEAD default this only applies
while GitHub's head is an older commit of your branch; a head your clone does
not have (a teammate's push) is evaluated as before. If GitHub still does not
show the expected commit after 3 minutes, the result is an error with
`staleHead: true` — check that the push went through. `expectedHead` names the
commit that was expected (null when none).

Result (stdout, one line):
  {"ok": true|false, "status": "...", "repo": "o/n", "pr": 7, "headSha": "...",
   "expectedHead": "..."|null,
   "ci": "passed|failed|none|pending", "merge": "clean|conflict|pending|skipped",
   "failingChecks": [...], "pendingChecks": [...], "supersededHeads": [...],
   "waitedSeconds": 42, "message": "..."}

Exit codes:
  0  passed — every check passed (status `passed`), or the PR has no CI
     (status `no-ci`); and, unless --no-conflict-check, it merges cleanly
  1  error — no GitHub token, PR/repo not found, PR closed or merged, or
     GitHub never showed the expected head commit (`staleHead: true`)
  2  usage error — bad arguments, or the repository could not be determined
  3  error — GitHub unreachable (repeated network failures)
  4  failed — at least one check failed (`failingChecks` names them)
  5  conflict — the PR has a merge conflict with its base branch
  6  timeout — not settled in time. Do NOT keep waiting in the background:
     end your turn and continue via a gated hand-off (`readinessGate`) or a
     `github-event` trigger on `pull_request.checks_passed` /
     `pull_request.checks_failed` / `pull_request.merge_conflict`.

Status note: once the wait really has to wait (an open PR whose verdict is not
settled on the first look), the runtime posts one short note in your chat room
("Pull request #N is open — waiting for CI…"). You do not need to announce the
wait yourself; your final reply still reports the verdict.

Rate limiting is backed off and retried, never reported as a failure. Reads go
through the GitHub CLI with this container's GitHub token (`GH_TOKEN`).
"""

import json
import os
import re
import subprocess
import sys
import time

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_UNREACHABLE = 3
EXIT_FAILED = 4
EXIT_CONFLICT = 5
EXIT_TIMEOUT = 6

EXIT_FOR_STATUS = {
    "passed": EXIT_OK,
    "no-ci": EXIT_OK,
    "failed": EXIT_FAILED,
    "conflict": EXIT_CONFLICT,
    "timeout": EXIT_TIMEOUT,
}

DEFAULT_TIMEOUT_MIN = 20.0
# Hard ceiling regardless of --timeout: a single wait must fit a default run
# (CLAUDE_TIMEOUT_SEC = 3600 in agent-entrypoint.py) with room to act after.
MAX_TIMEOUT_MIN = 50.0
# Kept free before the run's own deadline (`AEE_RUN_DEADLINE`, epoch seconds,
# set per turn by the runtime) so the agent can still act on the verdict.
DEADLINE_RESERVE_SEC = 120.0
DEFAULT_INTERVAL_SEC = 20.0
MAX_TRANSIENT_FAILURES = 5
RATE_LIMIT_BACKOFF_SEC = 60.0
RATE_LIMIT_BACKOFF_MAX_SEC = 300.0
# How long GitHub may keep showing an older head than the expected one (a push
# it has not reflected yet, #2818), and how often it is re-read meanwhile.
HEAD_SYNC_LIMIT_SEC = 180.0
HEAD_SYNC_INTERVAL_SEC = 5.0

TIMEOUT_ADVICE = (
    "Do not keep waiting in a background task — it is killed when your turn "
    "ends. End your turn and continue via a gated hand-off (readinessGate on the "
    "PR hand-off) or a github-event trigger on pull_request.checks_passed / "
    "pull_request.checks_failed / pull_request.merge_conflict."
)

SHA_RE = re.compile(r"^[0-9a-f]{40}$", re.I)


# ---- shared verdict rules (pr-readiness-rules.json, #2794/#2796) -------------

def _load_rules():
    here = os.path.dirname(os.path.realpath(__file__))
    with open(os.path.join(here, "pr-readiness-rules.json"), encoding="utf-8") as fh:
        return json.load(fh)


RULES = _load_rules()
CHECK_RUN_PASS = set(RULES["checkRun"]["pass"])
CHECK_RUN_FAIL = set(RULES["checkRun"]["fail"])
STATUS_PASS = set(RULES["statusContext"]["pass"])
STATUS_FAIL = set(RULES["statusContext"]["fail"])
MERGE_CLEAN = set(RULES["mergeable"]["clean"])
MERGE_CONFLICT = set(RULES["mergeable"]["conflict"])
MAX_CHECKS = int(RULES["maxChecks"])
DEFAULT_CI_GRACE_MS = int(RULES["ciGraceMs"])


def ci_grace_ms(env=None):
    """Same override as the orchestrator (`AEE_PR_READINESS_CI_GRACE_MS`)."""
    raw = (env if env is not None else os.environ).get("AEE_PR_READINESS_CI_GRACE_MS")
    if raw is None or str(raw).strip() == "":
        return DEFAULT_CI_GRACE_MS
    try:
        n = float(raw)
    except ValueError:
        return DEFAULT_CI_GRACE_MS
    return n if n >= 0 else DEFAULT_CI_GRACE_MS


def classify_check(node):
    """One check run or commit status → 'pass' | 'fail' | 'pending'. Mirrors
    classifyCheck in orchestrator/pr-readiness.js."""
    if not isinstance(node, dict):
        return "pending"
    if node.get("__typename") == "StatusContext" or ("state" in node and "status" not in node):
        state = str(node.get("state") or "").upper()
        if state in STATUS_PASS:
            return "pass"
        if state in STATUS_FAIL:
            return "fail"
        return "pending"
    if str(node.get("status") or "").upper() != "COMPLETED":
        return "pending"
    conclusion = str(node.get("conclusion") or "").upper()
    if conclusion in CHECK_RUN_PASS:
        return "pass"
    if conclusion in CHECK_RUN_FAIL:
        return "fail"
    return "pending"


def check_name(node):
    return str((isinstance(node, dict) and (node.get("name") or node.get("context"))) or "unnamed check")


def ci_verdict(checks, truncated=False, head_seen_at_ms=None, now_ms=None, grace_ms=DEFAULT_CI_GRACE_MS):
    """The CI verdict of one head commit → {'verdict', 'failingChecks'}. Mirrors
    ciVerdict in orchestrator/pr-readiness.js (pinned by the shared cases)."""
    items = [c for c in (checks or []) if c]
    failing = []
    pending = False
    for node in items:
        c = classify_check(node)
        if c == "fail":
            failing.append(check_name(node))
        elif c == "pending":
            pending = True
    if failing:
        return {"verdict": "failed", "failingChecks": sorted(set(failing))}
    if not items and not truncated:
        now_ms = time.time() * 1000 if now_ms is None else now_ms
        elapsed = now_ms - head_seen_at_ms if head_seen_at_ms is not None else 0
        return {"verdict": "none" if elapsed >= grace_ms else "pending", "failingChecks": []}
    if pending or truncated:
        return {"verdict": "pending", "failingChecks": []}
    return {"verdict": "passed", "failingChecks": []}


def merge_verdict(mergeable):
    m = str(mergeable or "").upper()
    if m in MERGE_CLEAN:
        return "clean"
    if m in MERGE_CONFLICT:
        return "conflict"
    return "pending"


def pending_check_names(checks):
    return sorted({check_name(n) for n in (checks or []) if n and classify_check(n) == "pending"})


# ---- GitHub reads -------------------------------------------------------------

PR_QUERY = ("query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){"
            "pullRequest(number:$number){number url state merged headRefName headRefOid mergeable}}}")

CHECKS_QUERY = ("query($owner:String!,$name:String!,$oid:GitObjectID!){repository(owner:$owner,name:$name){"
                "object(oid:$oid){... on Commit{oid statusCheckRollup{"
                f"contexts(first:{MAX_CHECKS}){{pageInfo{{hasNextPage}} nodes{{__typename "
                "... on CheckRun{name status conclusion} ... on StatusContext{context state}}}}}}}}")


class GhError(Exception):
    """kind: 'rate-limit' | 'auth' | 'not-found' | 'transient'."""

    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind


def classify_gh_failure(text):
    t = (text or "").lower()
    if "rate limit" in t or "http 429" in t or "abuse detection" in t:
        return "rate-limit"
    # Only GitHub's own wording / HTTP status: a bare "not found" or
    # "authentication" also appears in network errors (DNS, TLS), which must be
    # retried as transient rather than end the wait.
    if ("http 401" in t or "bad credentials" in t or "gh auth login" in t
            or "requires authentication" in t):
        return "auth"
    if "could not resolve to" in t or "http 404" in t:
        return "not-found"
    return "transient"


def real_gh():
    """The real GitHub CLI (reads need no chat-turn forwarding, see aee-gh)."""
    return os.environ.get("AEE_WAIT_CI_GH") or os.environ.get("AEE_REAL_GH") or "gh"


def gh_graphql(query, variables, host=None):
    args = [real_gh(), "api", "graphql", "-f", f"query={query}"]
    for k, v in variables.items():
        args += ["-F" if isinstance(v, int) else "-f", f"{k}={v}"]
    env = dict(os.environ)
    if host and host != "github.com" and not env.get("GH_HOST"):
        env["GH_HOST"] = host
    try:
        proc = subprocess.run(args, capture_output=True, text=True, timeout=60, env=env)
    except FileNotFoundError:
        raise GhError("auth", "the GitHub CLI (gh) is not installed in this container")
    except subprocess.TimeoutExpired:
        raise GhError("transient", "GitHub did not answer within 60s")
    out = proc.stdout or ""
    try:
        body = json.loads(out) if out.strip() else {}
    except ValueError:
        body = {}
    errors = body.get("errors") if isinstance(body, dict) else None
    if proc.returncode != 0 or errors:
        msg = "; ".join(str(e.get("message", e)) if isinstance(e, dict) else str(e) for e in (errors or []))
        msg = msg or (proc.stderr or out).strip() or f"gh exited {proc.returncode}"
        types = " ".join(str(e.get("type", "")) for e in (errors or []) if isinstance(e, dict))
        kind = "rate-limit" if "RATE_LIMITED" in types else (
            "not-found" if "NOT_FOUND" in types else classify_gh_failure(msg + " " + (proc.stderr or "")))
        raise GhError(kind, msg)
    return body.get("data") or {}


def read_pr(repo, number, gh=gh_graphql):
    owner, name, host = repo
    data = gh(PR_QUERY, {"owner": owner, "name": name, "number": number}, host)
    pr = (data.get("repository") or {}).get("pullRequest")
    if not pr:
        raise GhError("not-found", f"pull request #{number} not found in {owner}/{name}")
    return pr


def read_checks(repo, sha, gh=gh_graphql):
    """(checks, truncated) for one commit, addressed by SHA."""
    owner, name, host = repo
    data = gh(CHECKS_QUERY, {"owner": owner, "name": name, "oid": sha}, host)
    obj = (data.get("repository") or {}).get("object") or {}
    contexts = (obj.get("statusCheckRollup") or {}).get("contexts") or {}
    nodes = contexts.get("nodes") if isinstance(contexts.get("nodes"), list) else []
    return nodes, bool((contexts.get("pageInfo") or {}).get("hasNextPage"))


# ---- the wait -----------------------------------------------------------------

def effective_timeout_sec(requested_min, env=None, now=None):
    """--timeout in seconds, capped by MAX_TIMEOUT_MIN and by the run's own
    deadline (`AEE_RUN_DEADLINE` minus a reserve). Never negative."""
    env = env if env is not None else os.environ
    now = time.time() if now is None else now
    sec = min(float(requested_min), MAX_TIMEOUT_MIN) * 60.0
    raw = env.get("AEE_RUN_DEADLINE")
    if raw:
        try:
            sec = min(sec, float(raw) - now - DEADLINE_RESERVE_SEC)
        except ValueError:
            pass
    return max(0.0, sec)


def wait_for_ci(repo, number, timeout_sec, conflict_check=True, interval_sec=DEFAULT_INTERVAL_SEC,
                grace_ms=DEFAULT_CI_GRACE_MS, gh=gh_graphql, clock=time.time, sleep=time.sleep,
                log=lambda m: None, expected_head=None, local=None, on_waiting=None):
    """Poll until settled. Returns the result dict (always with `status`).

    `on_waiting` is called once, right before the first pause on an open PR —
    i.e. only when there really is something to wait for (not for a closed PR,
    a refused read or a verdict that is already settled on the first look).

    `expected_head` (from --head) is the commit the caller pushed: any other PR
    head is waited out, never evaluated. Without it, `local` — a LocalClone —
    supplies the expected head when the clone is on the PR's branch; then only
    an older commit of that branch is waited out (#2818)."""
    start = clock()
    deadline = start + timeout_sec
    expected = expected_head.lower() if expected_head else None
    explicit = expected is not None
    synced = False  # the expected head was seen (or the gate gave way)
    sync_started = None
    head = None
    head_seen_ms = None
    superseded = []
    transient = 0
    rate_backoff = RATE_LIMIT_BACKOFF_SEC
    last = {"ci": "pending", "merge": "pending" if conflict_check else "skipped",
            "failingChecks": [], "pendingChecks": []}

    announced = False

    def pause_for(seconds):
        nonlocal announced
        if not announced and head is not None and on_waiting is not None:
            announced = True
            try:
                on_waiting()
            except Exception:
                pass  # the note is best-effort, never the wait's problem
        sleep(seconds)

    def result(status, message, **extra):
        out = {"ok": status in ("passed", "no-ci"), "status": status,
               "repo": f"{repo[0]}/{repo[1]}", "pr": number, "headSha": head,
               "expectedHead": expected,
               **last, "supersededHeads": superseded,
               "waitedSeconds": int(round(clock() - start)), "message": message}
        out.update(extra)
        return out

    while True:
        try:
            pr = read_pr(repo, number, gh)
            state = str(pr.get("state") or "").upper()
            if state != "OPEN":
                what = "merged" if pr.get("merged") or state == "MERGED" else "closed"
                head = pr.get("headRefOid") or head
                return result("error", f"pull request #{number} is {what} — nothing to wait for",
                              prState=state or None)
            sha = str(pr.get("headRefOid") or "").lower()
            if not SHA_RE.match(sha):
                raise GhError("transient", "GitHub returned no head commit for the pull request")
            if expected is None and local is not None and not synced:
                expected = local.expected_head(pr.get("headRefName"))
            stale = False
            if expected and not synced:
                if sha == expected:
                    synced = True
                elif explicit or local.is_ancestor(sha, expected):
                    stale = True
                else:
                    synced = True
                    log(f"{sha[:7]} is not an older commit of your branch — evaluating it, "
                        f"not your local {expected[:7]}")
            if sha != head:
                if head:
                    superseded.append(head)
                    log(f"head moved {head[:7]} → {sha[:7]}; evaluating the new commit")
                head, head_seen_ms = sha, clock() * 1000
                last.update(ci="pending", failingChecks=[], pendingChecks=[])
            if stale:
                # GitHub has not caught up with the push yet: the old head's
                # verdict (red CI, a conflict) says nothing about the new one.
                sync_started = clock() if sync_started is None else sync_started
                if clock() - sync_started >= HEAD_SYNC_LIMIT_SEC:
                    return result("error", f"GitHub still shows {sha[:7]} as the head of #{number}, not "
                                  f"{expected[:7]}, after {int(HEAD_SYNC_LIMIT_SEC // 60)} min — check that "
                                  f"{expected[:7]} was pushed to the PR's branch, then wait again",
                                  staleHead=True)
                log(f"GitHub still shows {sha[:7]} as the head; waiting for {expected[:7]}")
                pause = min(interval_sec, HEAD_SYNC_INTERVAL_SEC)
                remaining = deadline - clock()
                if remaining <= 0:
                    return result("timeout", f"GitHub did not show {expected[:7]} as the head of #{number} "
                                  f"within {int(round(timeout_sec / 60))} min. " + TIMEOUT_ADVICE)
                pause_for(min(pause, remaining))
                continue
            if conflict_check:
                last["merge"] = merge_verdict(pr.get("mergeable"))
                if last["merge"] == "conflict":
                    return result("conflict", f"#{number} has a merge conflict with its base branch "
                                  "— rebase or merge the base, push, then wait again")
            checks, truncated = read_checks(repo, sha, gh)
            v = ci_verdict(checks, truncated, head_seen_ms, clock() * 1000, grace_ms)
            last.update(ci=v["verdict"], failingChecks=v["failingChecks"],
                        pendingChecks=pending_check_names(checks))
            transient = 0
            rate_backoff = RATE_LIMIT_BACKOFF_SEC
            if v["verdict"] == "failed":
                return result("failed", "CI failed on " + sha[:7] + ": " + ", ".join(v["failingChecks"]))
            if v["verdict"] in ("passed", "none") and last["merge"] in ("clean", "skipped"):
                if v["verdict"] == "none":
                    return result("no-ci", f"no check reported on {sha[:7]} within the grace period — the PR has no CI")
                return result("passed", f"all checks passed on {sha[:7]}")
            log(f"{sha[:7]}: ci={v['verdict']} merge={last['merge']}"
                + (f" (running: {', '.join(last['pendingChecks'][:5])})" if last["pendingChecks"] else ""))
            pause = interval_sec
        except GhError as e:
            if e.kind in ("auth", "not-found"):
                hint = ""
                if e.kind == "auth" and not (os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")):
                    hint = " (no GitHub token in this container — the environment needs a GitHub token)"
                return result("error", f"GitHub refused the read: {e}{hint}")
            if e.kind == "rate-limit":
                pause = rate_backoff
                rate_backoff = min(rate_backoff * 2, RATE_LIMIT_BACKOFF_MAX_SEC)
                log(f"rate-limited by GitHub, backing off {int(pause)}s")
            else:
                transient += 1
                if transient >= MAX_TRANSIENT_FAILURES:
                    return result("error", f"GitHub unreachable ({transient} attempts in a row): {e}",
                                  unreachable=True)
                pause = min(interval_sec * (2 ** (transient - 1)), 120.0)
                log(f"GitHub read failed ({e}); retrying in {int(pause)}s")
        remaining = deadline - clock()
        if remaining <= 0:
            return result("timeout", f"CI on #{number} not settled within {int(round(timeout_sec / 60))} min. "
                          + TIMEOUT_ADVICE)
        pause_for(min(pause, remaining))


# ---- the local clone (expected head) -------------------------------------------

def _git(directory, *args):
    try:
        return subprocess.run(["git", "-C", directory, *args], capture_output=True, text=True, timeout=10)
    except Exception:
        return None


class LocalClone:
    """The caller's clone of the PR's repository: where the pushed commit is."""

    def __init__(self, directory):
        self.directory = directory

    def head(self):
        r = _git(self.directory, "rev-parse", "HEAD")
        sha = r.stdout.strip().lower() if r and r.returncode == 0 else ""
        return sha if SHA_RE.match(sha) else None

    def branch(self):
        r = _git(self.directory, "symbolic-ref", "--short", "-q", "HEAD")
        return r.stdout.strip() if r and r.returncode == 0 and r.stdout.strip() else None

    def expected_head(self, pr_branch):
        """Local HEAD when the clone is on the PR's head branch, else None."""
        if not pr_branch or self.branch() != pr_branch:
            return None
        return self.head()

    def is_ancestor(self, sha, of):
        """True when `sha` is an older commit of `of` in this clone (unknown
        commits — e.g. a teammate's push not fetched — are not)."""
        r = _git(self.directory, "merge-base", "--is-ancestor", sha, of)
        return bool(r) and r.returncode == 0

    def resolve(self, rev):
        r = _git(self.directory, "rev-parse", "--verify", "-q", f"{rev}^{{commit}}")
        sha = r.stdout.strip().lower() if r and r.returncode == 0 else ""
        return sha if SHA_RE.match(sha) else None


def local_clone_dir(repo, repo_arg):
    """The clone of `repo` the caller works in: the git repo of the current
    directory, or the --repo clone directory — only if its origin is `repo`."""
    candidates = [_git_toplevel(os.getcwd())]
    if repo_arg and not ("/" in repo_arg and not os.path.isdir(repo_arg)):
        candidates += [repo_arg] + [os.path.join(r, repo_arg) for r in _workspace_roots()]
    for d in candidates:
        if d and os.path.isdir(d):
            origin = _origin_of(d)
            if origin and origin[:2] == repo[:2]:
                return _git_toplevel(d) or d
    return None


# ---- repository / PR resolution ----------------------------------------------

REMOTE_RE = re.compile(r"^(?:[a-z+]+://)?(?:[^@/]+@)?([^/:]+)[:/]+(?:\d+/)?([^/]+)/([^/]+?)(?:\.git)?/?$", re.I)
PR_URL_RE = re.compile(r"^https?://([^/]+)/([^/]+)/([^/]+)/pull/(\d+)(?:[/?#].*)?$", re.I)


def parse_remote(url):
    m = REMOTE_RE.match((url or "").strip())
    if not m:
        return None
    return m.group(2), m.group(3), m.group(1).lower()


def _origin_of(directory):
    try:
        r = subprocess.run(["git", "-C", directory, "remote", "get-url", "origin"],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    return parse_remote(r.stdout) if r.returncode == 0 else None


def _git_toplevel(directory):
    try:
        r = subprocess.run(["git", "-C", directory, "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def _workspace_roots():
    roots = [os.getcwd(), os.environ.get("HOME") or "", "/repo"]
    return [r for i, r in enumerate(roots) if r and r not in roots[:i]]


def resolve_repo(repo_arg):
    """(owner, name, host) or raises ValueError with an agent-readable reason."""
    if repo_arg:
        if "/" in repo_arg and not os.path.isdir(repo_arg):
            parsed = parse_remote(repo_arg) if ":" in repo_arg else None
            if parsed:
                return parsed
            parts = repo_arg.strip("/").split("/")
            if len(parts) == 2 and all(parts):
                return parts[0], parts[1], "github.com"
            raise ValueError(f"--repo {repo_arg!r} is neither a clone directory nor owner/name")
        candidates = [repo_arg] if os.path.isdir(repo_arg) else []
        candidates += [os.path.join(r, repo_arg) for r in _workspace_roots()]
        for d in candidates:
            if os.path.isdir(d):
                parsed = _origin_of(d)
                if parsed:
                    return parsed
        raise ValueError(f"--repo {repo_arg!r}: no clone with a GitHub origin found in your workspace")
    top = _git_toplevel(os.getcwd())
    if top:
        parsed = _origin_of(top)
        if parsed:
            return parsed
    found = []
    for root in _workspace_roots():
        try:
            for entry in sorted(os.listdir(root)):
                d = os.path.join(root, entry)
                if os.path.isdir(os.path.join(d, ".git")):
                    parsed = _origin_of(d)
                    if parsed and parsed not in found:
                        found.append(parsed)
        except OSError:
            continue
    if os.path.isdir("/repo/.git"):
        parsed = _origin_of("/repo")
        if parsed and parsed not in found:
            found.append(parsed)
    if len(found) == 1:
        return found[0]
    if not found:
        raise ValueError("cannot tell which repository — run inside a clone or pass --repo <name>")
    raise ValueError("several repositories in your workspace — pass --repo <name> ("
                     + ", ".join(f"{o}/{n}" for o, n, _ in found) + ")")


def parse_pr_arg(raw):
    """(number, repo-from-url-or-None)."""
    s = (raw or "").strip()
    m = PR_URL_RE.match(s)
    if m:
        return int(m.group(4)), (m.group(2), m.group(3), m.group(1).lower())
    s = s.lstrip("#")
    if s.isdigit() and int(s) > 0:
        return int(s), None
    raise ValueError(f"not a pull request number or URL: {raw!r}")


# ---- status note (#2841) --------------------------------------------------------

def announce_wait(repo, number, timeout_sec, env=None):
    """Tell the runtime a wait has started: one JSON line appended to the
    per-turn `AEE_STATUS_FILE`, which the runtime turns into a short status note
    in the run's chat room ("Pull request #N is open — waiting for CI…"). No
    file (no runtime, e.g. a local run) → nothing happens. Best-effort."""
    env = env if env is not None else os.environ
    path = env.get("AEE_STATUS_FILE")
    if not path:
        return False
    event = {"kind": "ci-wait", "repo": f"{repo[0]}/{repo[1]}", "host": repo[2], "pr": number,
             "timeoutMinutes": max(1, int(round(timeout_sec / 60)))}
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(event) + "\n")
        return True
    except OSError:
        return False


# ---- CLI ----------------------------------------------------------------------

def emit(obj, code):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()
    sys.exit(code)


def usage_error(msg):
    sys.stderr.write(f"aee-wait-ci: {msg}\n")
    sys.stderr.write("usage: aee-wait-ci <pr> [--repo <name>] [--timeout <minutes>] [--head <sha>] "
                     "[--no-conflict-check]\n")
    emit({"ok": False, "status": "error", "error": msg}, EXIT_USAGE)


def parse_args(argv):
    opts = {"pr": None, "repo": None, "timeout": DEFAULT_TIMEOUT_MIN, "conflict": True, "head": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--repo", "--timeout", "--head"):
            if i + 1 >= len(argv):
                usage_error(f"{a} needs a value")
            val = argv[i + 1]
            i += 2
        elif a.startswith(("--repo=", "--timeout=", "--head=")):
            a, val = a.split("=", 1)
            i += 1
        elif a == "--no-conflict-check":
            opts["conflict"] = False
            i += 1
            continue
        elif a == "--json":
            i += 1
            continue
        elif a.startswith("-") and not a.startswith("#"):
            usage_error(f"unknown option {a}")
        else:
            if opts["pr"] is not None:
                usage_error("exactly one pull request, please")
            opts["pr"] = a
            i += 1
            continue
        if a == "--repo":
            opts["repo"] = val
        elif a == "--head":
            if not val.strip():
                usage_error("--head needs a commit")
            opts["head"] = val.strip()
        else:
            try:
                opts["timeout"] = float(val)
            except ValueError:
                usage_error(f"--timeout must be a number of minutes, got {val!r}")
            if not opts["timeout"] > 0:
                usage_error("--timeout must be greater than 0")
    if opts["pr"] is None:
        usage_error("missing the pull request number")
    return opts


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return EXIT_OK
    opts = parse_args(argv)
    try:
        number, url_repo = parse_pr_arg(opts["pr"])
        repo = resolve_repo(opts["repo"]) if (opts["repo"] or not url_repo) else url_repo
    except ValueError as e:
        usage_error(str(e))
    clone_dir = local_clone_dir(repo, opts["repo"])
    local = LocalClone(clone_dir) if clone_dir else None
    expected_head = None
    if opts["head"]:
        expected_head = opts["head"].lower() if SHA_RE.match(opts["head"]) else (
            local.resolve(opts["head"]) if local else None)
        if not expected_head:
            usage_error(f"--head {opts['head']!r} is neither a full commit SHA nor a commit of your clone")
    timeout_sec = effective_timeout_sec(opts["timeout"])
    try:
        interval = float(os.environ.get("AEE_WAIT_CI_INTERVAL_SEC") or DEFAULT_INTERVAL_SEC)
    except ValueError:
        interval = DEFAULT_INTERVAL_SEC
    sys.stderr.write(f"aee-wait-ci: waiting up to {int(round(timeout_sec / 60))} min for "
                     f"{repo[0]}/{repo[1]}#{number}\n")
    res = wait_for_ci(repo, number, timeout_sec, conflict_check=opts["conflict"],
                      interval_sec=max(0.0, interval), grace_ms=ci_grace_ms(),
                      log=lambda m: sys.stderr.write(f"aee-wait-ci: {m}\n"),
                      expected_head=expected_head, local=local,
                      on_waiting=lambda: announce_wait(repo, number, timeout_sec))
    if res["status"] == "error":
        code = EXIT_UNREACHABLE if res.get("unreachable") else EXIT_ERROR
    else:
        code = EXIT_FOR_STATUS[res["status"]]
    res["exitCode"] = code
    emit(res, code)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
