#!/usr/bin/env python3
"""aee-ssh-sign — git's `gpg.ssh.program` inside an agent container (#2938).

When a signing key resolves for a run, the runtime configures git (per
invocation, via GIT_CONFIG_* env) with `gpg.format=ssh`, `commit.gpgsign=true`,
`user.signingkey=key::<public key>` and this program. Every commit-creating git
command — commit, amend, cherry-pick, rebase, merge, revert, and the
`knowledge` CLI's commits — then calls:

    aee-ssh-sign -Y sign -n git -f <public-key-file> -U <buffer-file>

and expects the signature in `<buffer-file>.sig`. The private key never enters
the container: this helper sends the payload to the orchestrator
(`POST /internal/agents/<id>/git/sign`), which signs it with the stored key
using `ssh-keygen -Y sign` and returns the signature.

Any failure exits non-zero with one clear message naming the credential and the
fix, so git FAILS the commit — a configured key never silently yields an
unsigned commit. Every other `-Y` operation (verify, find-principals,
check-novalidate) and any non-`-Y` use is handed to the real ssh-keygen.

Env: AGENT_ID, ORCHESTRATOR_INTERNAL_URL, AEE_INTERNAL_TOKEN (auth),
AEE_ACTING_SENDER (whose personal key, for a chat turn), AEE_SIGNING_LABEL
(names the credential in errors), AEE_SIGNING_ERROR (set by the runtime when
the configured key is unusable — every commit then fails with it).
"""

import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

REAL_SSH_KEYGEN = os.environ.get("AEE_REAL_SSH_KEYGEN", "/usr/bin/ssh-keygen")
TIMEOUT_SEC = 30
FIX = ("Fix: check the signing key under Credentials → SSH Keys (/ssh-keys) in Agent Studio — "
       "re-add or rotate it, or remove its signing identity to commit unsigned.")


def _fail(msg: str) -> "NoReturn":  # noqa: F821
    label = os.environ.get("AEE_SIGNING_LABEL") or "configured SSH signing key"
    sys.stderr.write(f"aee-ssh-sign: commit signing with the {label} failed: {msg}\n{FIX}\n")
    sys.exit(1)


def _parse_sign_args(argv):
    """→ (namespace, key_file, buffer_file) for `-Y sign`, else None."""
    if len(argv) < 2 or argv[0] != "-Y" or argv[1] != "sign":
        return None
    ns, key_file, rest = "git", None, []
    i = 2
    while i < len(argv):
        a = argv[i]
        if a == "-n" and i + 1 < len(argv):
            ns = argv[i + 1]
            i += 2
        elif a == "-f" and i + 1 < len(argv):
            key_file = argv[i + 1]
            i += 2
        elif a in ("-U", "-q"):
            i += 1
        elif a == "-O" and i + 1 < len(argv):
            i += 2
        else:
            rest.append(a)
            i += 1
    if not rest:
        return None
    return ns, key_file, rest[-1]


def _public_key_of(key_file):
    if not key_file:
        return ""
    try:
        with open(key_file, encoding="utf-8") as f:
            text = f.read().strip()
    except OSError:
        return ""
    if text.startswith("key::"):
        text = text[5:]
    parts = text.split()
    return " ".join(parts[:2]) if len(parts) >= 2 and parts[0].startswith(("ssh-", "ecdsa-", "sk-")) else ""


def _post_sign(payload: bytes, public_key: str, namespace: str) -> str:
    agent_id = os.environ.get("AGENT_ID", "")
    if not agent_id:
        _fail("AGENT_ID is not set in this container")
    base = (os.environ.get("ORCHESTRATOR_INTERNAL_URL") or "http://orchestrator:4002").rstrip("/")
    url = f"{base}/internal/agents/{urllib.parse.quote(agent_id, safe='')}/git/sign"
    body = json.dumps({
        "payload": base64.b64encode(payload).decode(),
        "publicKey": public_key,
        "namespace": namespace,
        "actingSender": os.environ.get("AEE_ACTING_SENDER", ""),
    }).encode()
    headers = {"Content-Type": "application/json"}
    token = os.environ.get("AEE_INTERNAL_TOKEN")
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(url, data=body, method="POST", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as r:
            data = json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read().decode() or "{}").get("error")
        except ValueError:
            err = None
        _fail(err or f"the orchestrator answered HTTP {e.code}")
    except (urllib.error.URLError, OSError, ValueError) as e:
        _fail(f"could not reach the orchestrator to sign ({e})")
    sig = data.get("signature") if isinstance(data, dict) else None
    if not sig or "BEGIN SSH SIGNATURE" not in sig:
        _fail("the orchestrator returned no signature")
    return sig


def main(argv) -> int:
    parsed = _parse_sign_args(argv)
    if parsed is None:
        os.execv(REAL_SSH_KEYGEN, [REAL_SSH_KEYGEN, *argv])
    namespace, key_file, buffer_file = parsed
    configured_error = os.environ.get("AEE_SIGNING_ERROR")
    if configured_error:
        _fail(configured_error)
    try:
        with open(buffer_file, "rb") as f:
            payload = f.read()
    except OSError as e:
        _fail(f"cannot read the data to sign ({e})")
    sig = _post_sign(payload, _public_key_of(key_file), namespace)
    try:
        with open(buffer_file + ".sig", "w", encoding="utf-8") as f:
            f.write(sig)
    except OSError as e:
        _fail(f"cannot write the signature ({e})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
