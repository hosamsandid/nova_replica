#!/usr/bin/env python3
"""knowledge — record and query the shared team Knowledge Base (KB).

The KB is tier T1 of the Shared Agent Learning & Knowledge Flow: durable,
team-scoped facts/entities/conventions that outlive a single run and help every
teammate on the repo. It is git-backed markdown/JSONL (the durable bridge is
git, same doctrine as aee-artifact), synced into a local working copy so queries
are real-time and offline.

Record a durable lesson (provenance is attached automatically):

    knowledge add fact "This repo unit-tests pure helper cores only"
    knowledge add entity "github-poller.js polls the Events API every 30s" --tag polling
    knowledge add convention "Branch from origin/main" --source pr:459

Query what the team already knows (offline search over the synced copy):

    knowledge search "poller pagination"
    knowledge search "npm install" --kind fact --json --limit 5

Inspect:

    knowledge list                 # everything (JSON lines)
    knowledge list --mine          # only what this agent recorded
    knowledge path "<id>"          # which file holds an entry

Nominate a durable fact to become a reusable team skill (raises a suggestion
card; a human confirms the promotion in Agent Studio — never automatic):

    knowledge promote <id>
    knowledge promote <id> --note "worth generalising into a skill"

Keep a fact as your OWN private skill (agent tier — no human needed; lift it to
the team later from Agent Studio):

    knowledge promote <id> --to agent
    knowledge promote <id> --to agent --name my-private-skill

Each agent appends only to its OWN shard (<kind>/shards/<agentId>.jsonl) so
concurrent writes from N agents never conflict; `knowledge add` commits it with
your agent identity and pushes it to the shared `agent-knowledge` branch via the
orchestrator, so teammates see it on their next `knowledge search`.

Team scope (KNOWLEDGE_TEAM_ID):

    Every entry is scoped to a team. The team is resolved as: an explicit
    KNOWLEDGE_TEAM_ID environment variable (injected by the orchestrator at spawn)
    wins; otherwise it falls back to this agent's config.json using the same
    precedence as the orchestrator — parentTeamId, then id (when role is "team"),
    then teamId, then "default". So `knowledge` works outside the orchestrator
    runtime too (e.g. a manual shell), and never mis-scopes: set KNOWLEDGE_TEAM_ID
    by hand only to deliberately override the config-derived team.

Every data subcommand (add / search / list / path / promote) accepts --json for
a machine-readable object on stdout.

Exit codes (shared CLI contract, docs/cli-contract.md): 0 ok · 1 domain error
(search/path/promote found nothing; a local write or commit failed) · 2
usage/validation error. `knowledge add` treats a failed push as a soft warning —
the entry is recorded locally and shared on the next push — so it still exits 0.
"""

import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone

# ===========================================================================
# Pure core — a Python mirror of orchestrator/knowledge-store.js. No fs / no
# network here (an injected `now`/`id_gen` keeps it deterministic); the thin
# cmd_* wrappers below own all IO. Unit-tested in test_knowledge.py.
# ===========================================================================

KINDS = ("fact", "entity", "convention")
SOURCE_REF_KINDS = ("pr", "issue", "commit", "branch", "url")
STATUSES = ("active", "merged", "promoted", "archived", "pending", "rejected")
# Statuses that are NOT part of the shared, curated team knowledge and so must be
# hidden from `knowledge search` / `list`: merge tombstones, retired entries, and
# supervised-review holds. Mirrors the admin-console graph folds (foldMerges /
# foldArchived / foldReview) so an agent's query and the operator's view agree.
HIDDEN_STATUSES = frozenset(("merged", "archived", "pending", "rejected"))

SCHEMA_VERSION = 1
MANIFEST_VERSION = 1
DEFAULT_KB_PATH = "docs/agent-knowledge/"
DEFAULT_TEAM_ID = "default"

# Stable key order so git diffs are minimal and the serialized line is
# byte-identical to knowledge-store.js `serializeEntry` (cross-runtime guard).
KEY_ORDER = (
    "v", "id", "kind", "text", "originAgent", "teamId", "createdAt",
    "correlationId", "sessionId", "sourceRefs", "convergence", "tags",
    "status", "updatedAt", "summary", "validFrom", "validTo", "supersededBy",
    "loadTriggers",
)

# #917: the closed auto-load trigger-type set (mirrors knowledge-store.js).
LOAD_TRIGGER_TYPES = ("keyword", "path")


def resolve_team_id_from_config(cfg):
    """Resolve the KB team from an agent's config — a Python mirror of the
    orchestrator's agentKnowledgeTeamId (orchestrator/orchestrator.js). Precedence:
    parentTeamId → (id when role == "team") → teamId → DEFAULT_TEAM_ID. Kept in
    lock-step with the JS so a `knowledge` invocation outside the orchestrator-
    spawned runtime scopes writes to the SAME team the orchestrator would inject.
    """
    if not isinstance(cfg, dict):
        return DEFAULT_TEAM_ID
    parent = cfg.get("parentTeamId")
    if isinstance(parent, str) and parent.strip():
        return parent
    if cfg.get("role") == "team":
        cid = cfg.get("id")
        if isinstance(cid, str) and cid.strip():
            return cid
    team = cfg.get("teamId")
    if isinstance(team, str) and team.strip():
        return team
    return DEFAULT_TEAM_ID


def _default_id_gen():
    return os.urandom(6).hex()


def _default_now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _norm_str_array(arr):
    if not isinstance(arr, list):
        return []
    seen = set()
    out = []
    for v in arr:
        if not isinstance(v, str):
            continue
        t = v.strip()
        if t == "" or t in seen:
            continue
        seen.add(t)
        out.append(t)
    return out


def normalize_source_refs(source_refs):
    if not isinstance(source_refs, list):
        return []
    out = []
    for ref in source_refs:
        if not isinstance(ref, dict):
            continue
        kind = ref.get("kind")
        val = ref.get("ref")
        if kind not in SOURCE_REF_KINDS:
            continue
        if not isinstance(val, str) or val.strip() == "":
            continue
        out.append({"kind": kind, "ref": val.strip()})
    return out


def has_provenance_link(entry):
    """Provenance is mandatory: at least one hard link back to the session/PR."""
    return (
        (isinstance(entry.get("correlationId"), str) and entry["correlationId"].strip() != "")
        or (isinstance(entry.get("sessionId"), str) and entry["sessionId"].strip() != "")
        or (isinstance(entry.get("sourceRefs"), list) and len(entry["sourceRefs"]) > 0)
    )


def validate_entry(entry):
    """Validate a fully-formed entry. Returns (ok, errors)."""
    errors = []
    if not isinstance(entry, dict):
        return False, ["entry is not an object"]
    if entry.get("v") != SCHEMA_VERSION:
        errors.append(f"v must be {SCHEMA_VERSION}")
    if not isinstance(entry.get("id"), str) or not re.fullmatch(r"[0-9a-f]{12}", entry.get("id", "")):
        errors.append("id must be a 12-char hex string")
    if entry.get("kind") not in KINDS:
        errors.append("kind must be one of " + "|".join(KINDS))
    if not isinstance(entry.get("text"), str) or entry.get("text", "").strip() == "":
        errors.append("text must be a non-empty string")
    if not isinstance(entry.get("originAgent"), str) or entry.get("originAgent", "").strip() == "":
        errors.append("originAgent is required (provenance)")
    if not isinstance(entry.get("teamId"), str) or entry.get("teamId", "").strip() == "":
        errors.append("teamId is required (provenance)")
    if not isinstance(entry.get("createdAt"), str) or entry.get("createdAt", "").strip() == "":
        errors.append("createdAt is required (provenance)")
    if not has_provenance_link(entry):
        errors.append("at least one of correlationId, sessionId or sourceRefs is required (provenance)")
    conv = entry.get("convergence")
    if not isinstance(conv, list) or len(conv) == 0:
        errors.append("convergence must be a non-empty array")
    if entry.get("status") not in STATUSES:
        errors.append("status must be one of " + "|".join(STATUSES))
    if entry.get("summary") is not None and not isinstance(entry.get("summary"), str):
        errors.append("summary must be a string when present")
    # Bitemporal validity (#916) — optional; expiry is a FIELD, not a status
    # (readers derive "expired" from validTo, STATUSES stays untouched).
    if "validFrom" in entry and (not isinstance(entry.get("validFrom"), str) or entry["validFrom"].strip() == ""):
        errors.append("validFrom must be a non-empty string when present")
    if "validTo" in entry and (not isinstance(entry.get("validTo"), str) or entry["validTo"].strip() == ""):
        errors.append("validTo must be a non-empty string when present")
    if "supersededBy" in entry and (not isinstance(entry.get("supersededBy"), str)
                                    or not re.fullmatch(r"[0-9a-f]{12}", entry["supersededBy"])):
        errors.append("supersededBy must be a 12-char hex entry id when present")
    # Scoped auto-load triggers (#917) — optional; each { type, pattern }.
    if "loadTriggers" in entry:
        lt = entry.get("loadTriggers")
        if not isinstance(lt, list) or any(
            not isinstance(t, dict) or t.get("type") not in LOAD_TRIGGER_TYPES
            or not isinstance(t.get("pattern"), str) or t["pattern"].strip() == ""
            for t in lt
        ):
            errors.append("loadTriggers entries must be { type: keyword|path, pattern: <non-empty> }")
    return len(errors) == 0, errors


def build_entry(kind, text, *, origin_agent="", team_id="", correlation_id=None,
                session_id=None, source_refs=None, tags=None, status="active",
                convergence=None, entry_id=None, created_at=None, summary=None,
                valid_from=None, valid_to=None, superseded_by=None,
                now=_default_now, id_gen=_default_id_gen):
    """Build a validated KB entry with defaults + provenance filled in.

    Raises ValueError on invalid input so a caller can never silently emit an
    unprovenanced entry (mirrors makeKnowledgeEntry).
    """
    if kind not in KINDS:
        raise ValueError("build_entry: kind must be one of " + "|".join(KINDS))
    text = text.strip() if isinstance(text, str) else ""
    if text == "":
        raise ValueError("build_entry: text must be a non-empty string")

    origin_agent = origin_agent.strip() if isinstance(origin_agent, str) else ""
    team_id = team_id.strip() if isinstance(team_id, str) else ""
    refs = normalize_source_refs(source_refs)

    conv_src = convergence if isinstance(convergence, list) and convergence else [origin_agent]

    entry = {
        "v": SCHEMA_VERSION,
        "id": entry_id if isinstance(entry_id, str) and re.fullmatch(r"[0-9a-f]{12}", entry_id) else id_gen(),
        "kind": kind,
        "text": text,
        "originAgent": origin_agent,
        "teamId": team_id,
        "createdAt": created_at.strip() if isinstance(created_at, str) and created_at.strip() != "" else now(),
        "convergence": _norm_str_array(conv_src),
        "status": status if status in STATUSES else "active",
    }

    if isinstance(correlation_id, str) and correlation_id.strip() != "":
        entry["correlationId"] = correlation_id.strip()
    if isinstance(session_id, str) and session_id.strip() != "":
        entry["sessionId"] = session_id.strip()
    if refs:
        entry["sourceRefs"] = refs
    tag_list = _norm_str_array(tags)
    if tag_list:
        entry["tags"] = tag_list
    # Optional human-readable summary (distinct from the agent-facing text);
    # written only by the orchestrator backfill path, never the agent CLI.
    if isinstance(summary, str) and summary.strip() != "":
        entry["summary"] = summary.strip()
    # Bitemporal validity (#916) — optional; absent ⇒ behaviour identical to
    # today (validFrom semantically defaults to createdAt at read time).
    if isinstance(valid_from, str) and valid_from.strip() != "":
        entry["validFrom"] = valid_from.strip()
    if isinstance(valid_to, str) and valid_to.strip() != "":
        entry["validTo"] = valid_to.strip()
    if isinstance(superseded_by, str) and re.fullmatch(r"[0-9a-f]{12}", superseded_by):
        entry["supersededBy"] = superseded_by

    ok, errors = validate_entry(entry)
    if not ok:
        raise ValueError("build_entry: invalid entry — " + "; ".join(errors))
    return entry


def serialize_entry(entry):
    """Serialize to one JSONL line, key order + spacing identical to the JS core."""
    ordered = {}
    for k in KEY_ORDER:
        if entry.get(k) is not None:
            ordered[k] = entry[k]
    for k in entry:
        if k not in ordered:
            ordered[k] = entry[k]
    return json.dumps(ordered, ensure_ascii=False, separators=(",", ":"))


def parse_entry(line):
    """Tolerant parse of one JSONL line — a mangled line returns None."""
    if not isinstance(line, str):
        return None
    trimmed = line.strip()
    if trimmed == "":
        return None
    try:
        obj = json.loads(trimmed)
    except (json.JSONDecodeError, ValueError):
        return None
    if not isinstance(obj, dict):
        return None
    return obj


def match_entries(entries, query, kind=None):
    """Filter entries whose text/tags match the (case-insensitive regex) query.

    An invalid regex falls back to a literal substring match, so a query with
    stray regex metacharacters never crashes a search.
    """
    if kind is not None and kind not in KINDS:
        return []
    try:
        pat = re.compile(query, re.IGNORECASE) if query else None
    except re.error:
        pat = None
    q_lower = (query or "").lower()

    def hit(e):
        if kind is not None and e.get("kind") != kind:
            return False
        if not query:
            return True
        hay = " ".join([e.get("text", "")] + [str(t) for t in (e.get("tags") or [])])
        if pat is not None:
            return pat.search(hay) is not None
        return q_lower in hay.lower()

    return [e for e in entries if hit(e)]


def _entry_time(e):
    """Sort key for last-writer-wins: updatedAt, else createdAt, else ''."""
    return (e.get("updatedAt") or e.get("createdAt") or "")


def entry_expired(e, now):
    """Bitemporal expiry (#916): an entry whose validTo lies before the injected
    `now` is no longer current. Field-derived (never a status); ISO-8601 UTC
    strings compare lexicographically == chronologically, so this is a plain
    string comparison — identical in all four fold mirrors. No `now` ⇒ never
    expired (the pure cores have no clock)."""
    vt = e.get("validTo") if isinstance(e, dict) else None
    return (isinstance(vt, str) and vt != ""
            and isinstance(now, str) and now != "" and vt < now)


def visible_entries(entries, now=None):
    """Reduce raw shard+canonical lines to the shared, curated team knowledge an
    agent should actually see: collapse copies that share an id (last writer wins),
    then drop the ones whose latest status is a merge tombstone, a retired entry, or
    a supervised-review hold (pending/rejected) — or whose validTo lies before the
    injected `now` (#916; expired folds out exactly like archived). Pure — mirrors
    the admin-console graph folds so `knowledge search` and the operator's
    Knowledge Flow agree, and so a fact a human has NOT yet approved never reaches
    a teammate's query.

    Iteration order is preserved by `createdAt` then first-seen so output is stable;
    within one id the copy with the newest time wins (ties keep the last seen, which
    is the canonical file since callers read shards before canonical)."""
    latest = {}
    order = []
    for e in entries:
        eid = e.get("id")
        if not isinstance(eid, str) or eid == "":
            continue
        if eid not in latest:
            order.append(eid)
            latest[eid] = e
        elif _entry_time(e) >= _entry_time(latest[eid]):
            latest[eid] = e
    out = [latest[eid] for eid in order
           if latest[eid].get("status") not in HIDDEN_STATUSES
           and not entry_expired(latest[eid], now)]
    out.sort(key=lambda e: (e.get("createdAt") or "", e.get("id") or ""))
    return out


def build_default_manifest():
    return {
        "manifestVersion": MANIFEST_VERSION,
        "schemaVersion": SCHEMA_VERSION,
        "kinds": {
            "fact": {"dir": "facts", "file": "facts.jsonl"},
            "entity": {"dir": "entities", "file": "entities.jsonl"},
            "convention": {"dir": "conventions", "file": "conventions.jsonl"},
        },
    }


def kind_dir(manifest, kind):
    m = (manifest or {}).get("kinds", {}).get(kind)
    if not isinstance(m, dict) or not isinstance(m.get("dir"), str):
        raise ValueError(f"manifest has no entry for kind '{kind}'")
    return m["dir"].rstrip("/")


def kind_canonical_file(manifest, kind):
    m = (manifest or {}).get("kinds", {}).get(kind)
    if not isinstance(m, dict) or not isinstance(m.get("file"), str):
        raise ValueError(f"manifest has no entry for kind '{kind}'")
    return f"{m['dir'].rstrip('/')}/{m['file']}"


def lean_summary(entry):
    """The provenance-lean push summary for the Phase-2 live feed.

    Only whitelisted fields (id/kind/text/originAgent/convergenceCount) — no
    secrets; the same values the shard already exposes. The orchestrator echoes
    these into the knowledge feed after a successful push. Mirrors leanEntry in
    orchestrator/knowledge-feed.js.
    """
    if not isinstance(entry, dict) or not isinstance(entry.get("id"), str):
        return None
    conv = entry.get("convergence")
    count = len(conv) if isinstance(conv, list) and conv else 1
    return {
        "id": entry["id"],
        "kind": entry.get("kind", "fact"),
        "text": entry.get("text", ""),
        "originAgent": entry.get("originAgent"),
        "convergenceCount": count,
    }


def build_nomination(entry_id, note, agent_id):
    """The POST body for `knowledge promote <id>` (Phase 3 nomination).

    Pure — the network POST lives in _nominate_via_orchestrator. Nominating
    RAISES a promotion suggestion card for a human to confirm; it never promotes.
    """
    body = {"entryId": entry_id, "agentId": agent_id}
    if isinstance(note, str) and note.strip():
        body["note"] = note.strip()
    return body


SKILL_NAME_RE = re.compile(r"^[a-zA-Z0-9_-]+([.:][a-zA-Z0-9_-]+)*$")


def slugify_skill_name(text, kind="fact"):
    """Safe skill slug from free text; falls back to a kind-based name. Mirrors
    slugifySkillName in admin-console/api/knowledge-suggestions.js + the curator."""
    base = re.sub(r"[^a-z0-9]+", "-", str(text or "").lower()).strip("-")
    base = "-".join(base.split("-")[:6])
    if base and SKILL_NAME_RE.match(base):
        return base
    return f"{kind}-skill"


def build_agent_skill(entry, *, name=None, agent_id="", team_id="", now=_default_now):
    """Build a PRIVATE agent-tier skill from a KB entry (`knowledge promote --to
    agent`). Pure — the local dir write lives in _write_agent_skill.

    The agent tier is the bottom rung of the Agent → Team → Global ladder: a
    personal specialisation the agent keeps in its own pool, later liftable to the
    team (agent→team) from Agent Studio. Provenance is MANDATORY and carried
    on `provenance.json` (entryIds present) so the lift + the graph's promoted
    edge resolve. Returns {name, skill_md, provenance}. Raises ValueError on bad
    input so a caller can never write an unprovenanced skill.
    """
    if not isinstance(entry, dict) or not isinstance(entry.get("id"), str):
        raise ValueError("build_agent_skill: an entry with an id is required")
    text = (entry.get("text") or "").strip()
    kind = entry.get("kind", "fact")
    skill_name = name.strip() if isinstance(name, str) and name.strip() else slugify_skill_name(text, kind)
    if not SKILL_NAME_RE.match(skill_name):
        raise ValueError(f"build_agent_skill: invalid skill name '{skill_name}'")
    origin = entry.get("originAgent") or agent_id or "unknown"
    convergence = entry.get("convergence") if isinstance(entry.get("convergence"), list) else [origin]
    ts = now() if callable(now) else now
    team = team_id or entry.get("teamId") or "default"

    skill_md = "\n".join([
        f"# {text or 'Personal knowledge'}",
        "",
        "## What",
        "",
        f"- {text}",
        "",
        "## Why this is a skill",
        "",
        "A durable lesson this agent recorded, kept as a private skill for reuse.",
        "",
        "## Provenance",
        "",
        f"Authored from knowledge base entry `{entry['id']}` by {origin}.",
        "",
    ])
    provenance = {
        "fromTier": "team",
        "toTier": "agent",
        "teamId": team,
        "entryIds": [entry["id"]],
        "canonicalId": entry["id"],
        "originAgents": [origin],
        "convergence": convergence,
        "sourceRefs": entry.get("sourceRefs") if isinstance(entry.get("sourceRefs"), list) else [],
        "sessions": (
            [{"agentId": origin, "correlationId": entry["correlationId"]}]
            if isinstance(entry.get("correlationId"), str) and entry["correlationId"].strip() else []
        ),
        "originTeamId": team,
        "promotedAt": ts,
        "promotedBy": agent_id or origin,
    }
    return {"name": skill_name, "skill_md": skill_md, "provenance": provenance}


def parse_source_ref(spec):
    """`pr:123` / `issue:9` / `url:https://…` -> {kind, ref}; else None."""
    if not isinstance(spec, str) or ":" not in spec:
        return None
    kind, ref = spec.split(":", 1)
    kind = kind.strip()
    ref = ref.strip()
    if kind not in SOURCE_REF_KINDS or ref == "":
        return None
    return {"kind": kind, "ref": ref}


# ===========================================================================
# IO layer — store resolution, working-copy read/write, git + orchestrator push
# ===========================================================================

BRANCH = os.environ.get("KNOWLEDGE_BRANCH", "agent-knowledge")


def _agent_id():
    return os.environ.get("AGENT_ID", "unknown")


def _load_agent_config():
    """Best-effort read of this agent's config.json (…/agents/<AGENT_ID>/). Never
    raises — a missing/mangled config just yields {} so team resolution falls back
    to DEFAULT_TEAM_ID rather than hard-failing the command."""
    p = os.path.join("/workspace/agents", _agent_id(), "config.json")
    try:
        with open(p, "r", encoding="utf-8") as fh:
            cfg = json.load(fh)
    except (OSError, ValueError):
        return {}
    return cfg if isinstance(cfg, dict) else {}


def _team_id():
    """The KB team for this invocation.

    An explicit KNOWLEDGE_TEAM_ID wins (the orchestrator injects it at spawn), so
    orchestrator-spawned runs behave exactly as before. When it is unset/empty —
    any other context (Claude Code harness, a manual shell, a re-exec'd process) —
    fall back to the agent's config.json with the orchestrator's own precedence,
    so `knowledge add` still records under the correct team instead of hard-failing
    on the missing env var or being mis-scoped by a hand-set guess."""
    env = os.environ.get("KNOWLEDGE_TEAM_ID", "")
    if isinstance(env, str) and env.strip():
        return env
    return resolve_team_id_from_config(_load_agent_config())


def _checkout_root():
    """The KB working copy (a git checkout of the agent-knowledge branch)."""
    explicit = os.environ.get("KNOWLEDGE_DIR")
    if explicit:
        return explicit
    return os.path.join("/workspace/agents", _agent_id(), "knowledge")


def _store_root():
    """The KB root within the checkout (…/docs/agent-knowledge/)."""
    rel = os.environ.get("KNOWLEDGE_STORE_PATH", DEFAULT_KB_PATH).strip("/")
    root = _checkout_root()
    return os.path.join(root, rel) if rel else root


def _load_manifest():
    p = os.path.join(_store_root(), "knowledge.manifest.json")
    if os.path.exists(p):
        try:
            with open(p, "r", encoding="utf-8") as fh:
                m = json.load(fh)
            if isinstance(m, dict) and isinstance(m.get("kinds"), dict):
                return m
        except (OSError, ValueError):
            pass
    return build_default_manifest()


def _shard_path(manifest, kind):
    return os.path.join(_store_root(), kind_dir(manifest, kind), "shards", f"{_agent_id()}.jsonl")


def _git(*args, timeout=15):
    return subprocess.run(
        ["git", "-C", _checkout_root(), *args],
        capture_output=True, text=True, timeout=timeout,
    )


def build_commit_args(agent_id, kind, entry_id):
    """The `git` args (after the `-C <checkout>` already added by `_git`) for a KB
    `add` commit.

    Mirrors `gh-as-agent commit` (agent-image/scripts/gh-as-agent): the committer
    identity is set INLINE via `-c user.name`/`-c user.email` so the commit
    succeeds even when no ambient git identity is configured (the chat/harness
    path, a manual shell) — without ever touching the global/system git config.
    The author keeps the `<agentId>@agents.local` marker the poller reads for loop
    protection. Pure (just string assembly) so it is unit-tested directly.
    """
    return [
        "-c", f"user.name=agent-{agent_id}",
        "-c", f"user.email=agent-{agent_id}@ace.local",
        "commit",
        "--author", f"{agent_id} <{agent_id}@agents.local>",
        "-m", f"knowledge({kind}): {entry_id}",
    ]


def _read_all_entries(manifest, kind=None):
    """Read every entry from all shard files (+ any curated canonical file)."""
    import glob
    root = _store_root()
    kinds = [kind] if kind else list(KINDS)
    out = []
    for k in kinds:
        try:
            kdir = kind_dir(manifest, k)
        except ValueError:
            continue
        files = sorted(glob.glob(os.path.join(root, kdir, "shards", "*.jsonl")))
        canonical = os.path.join(root, kind_canonical_file(manifest, k))
        if os.path.exists(canonical):
            files.append(canonical)
        for fpath in files:
            try:
                with open(fpath, "r", encoding="utf-8") as fh:
                    for line in fh:
                        e = parse_entry(line)
                        if e is not None:
                            out.append((e, fpath))
            except OSError:
                continue
    return out


def _refresh_checkout():
    """Best-effort pull-on-demand. Never raises — offline search still works."""
    root = _checkout_root()
    if not os.path.isdir(os.path.join(root, ".git")):
        return
    try:
        _git("fetch", "origin", BRANCH, timeout=15)
        _git("checkout", BRANCH, timeout=10)
        _git("reset", "--hard", f"origin/{BRANCH}", timeout=10)
    except (subprocess.SubprocessError, OSError):
        pass


# Internal-API credential (#1456, GOV-PLATFORM-2). `startAgentProcess` bakes a
# per-agent token into the container env, exactly like the GitHub PAT; it is
# valid only for the agent-facing allowlist and only for this agent's own id.
# Absent — a stack that has not armed the gate — the call goes out
# unauthenticated and the orchestrator behaves exactly as it did before.
# Duplicated across the agent-side CLIs on purpose: each is a dependency-free
# single file by contract (docs/cli-contract.md §4.5), so there is nowhere
# shared to put it.
def internal_headers(extra=None):
    headers = dict(extra or {})
    token = os.environ.get("AEE_INTERNAL_TOKEN")
    if token:
        headers["Authorization"] = "Bearer " + token
    return headers


def _push_via_orchestrator(entries=None):
    """Route the credentialed push through the orchestrator (mirrors gh-as-agent).

    Carries a lean summary of the just-added entries so the orchestrator can echo
    them into the Phase-2 live feed. The values are already in the shard, so
    nothing secret is added; an empty body still works (older orchestrator).
    """
    base = (os.environ.get("ORCHESTRATOR_INTERNAL_URL")
            or os.environ.get("AEE_ORCHESTRATOR_URL")
            or "http://orchestrator:4002").rstrip("/")
    url = f"{base}/internal/agents/{_agent_id()}/knowledge/push"
    summaries = [s for s in (lean_summary(e) for e in (entries or [])) if s]
    payload = json.dumps({"entries": summaries}).encode("utf-8")
    req = urllib.request.Request(
        url, data=payload, method="POST",
        headers=internal_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode("utf-8", "replace")
        return True, body
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace") if exc.fp else str(exc)
        return False, f"HTTP {exc.code}: {detail}"
    except (urllib.error.URLError, OSError) as exc:
        return False, str(exc)


def _post_retrieval(source, entry_ids):
    """Read-side retrieval telemetry (#915): report which entry ids a local
    search/list returned, so the orchestrator's per-team aggregate can track
    "last used". Strictly best-effort fire-and-forget — a telemetry outage must
    never break (or slow) search: short timeout, every failure silent. The query
    text is deliberately NOT sent (privacy decision: ids + count suffice)."""
    ids = [i for i in entry_ids if isinstance(i, str) and re.fullmatch(r"[0-9a-f]{12}", i)]
    if not ids:
        return
    base = (os.environ.get("ORCHESTRATOR_INTERNAL_URL")
            or os.environ.get("AEE_ORCHESTRATOR_URL")
            or "http://orchestrator:4002").rstrip("/")
    url = f"{base}/internal/agents/{_agent_id()}/knowledge/retrieval"
    payload = json.dumps({
        "source": source,
        "entryIds": ids,
        "hitCount": len(ids),
        "ts": _default_now(),
    }).encode("utf-8")
    req = urllib.request.Request(
        url, data=payload, method="POST",
        headers=internal_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=3):
            pass
    except Exception:  # noqa: BLE001 — telemetry is never allowed to fail the CLI
        pass


# ===========================================================================
# Commands
# ===========================================================================

# Shared CLI-contract exit codes (docs/cli-contract.md).
EXIT_OK = 0
EXIT_DOMAIN = 1
EXIT_USAGE = 2


def _die(msg, code=EXIT_USAGE):
    sys.stderr.write(f"knowledge: {msg}\n")
    sys.exit(code)


def cmd_add(argv):
    tags = []
    source_refs = []
    as_json = False
    no_push = False
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--tag":
            i += 1
            if i < len(argv):
                tags.append(argv[i])
        elif a.startswith("--tag="):
            tags.append(a[len("--tag="):])
        elif a == "--source":
            i += 1
            if i < len(argv):
                ref = parse_source_ref(argv[i])
                if not ref:
                    _die(f"invalid --source '{argv[i]}' (expected pr:123 / issue:9 / commit:sha / branch:name / url:…)")
                source_refs.append(ref)
        elif a.startswith("--source="):
            ref = parse_source_ref(a[len("--source="):])
            if not ref:
                _die("invalid --source value")
            source_refs.append(ref)
        elif a == "--json":
            as_json = True
        elif a == "--no-push":
            no_push = True
        else:
            pos.append(a)
        i += 1

    if len(pos) < 2:
        _die('add: usage: knowledge add <fact|entity|convention> "<text>" [--tag t] [--source pr:123] [--json] [--no-push]')
    kind, text = pos[0], pos[1]

    try:
        entry = build_entry(
            kind, text,
            origin_agent=_agent_id(),
            team_id=_team_id(),
            correlation_id=os.environ.get("KNOWLEDGE_CORRELATION_ID"),
            session_id=os.environ.get("KNOWLEDGE_SESSION_ID"),
            source_refs=source_refs,
            tags=tags,
        )
    except ValueError as exc:
        _die(str(exc))

    manifest = _load_manifest()
    shard = _shard_path(manifest, kind)
    try:
        os.makedirs(os.path.dirname(shard), exist_ok=True)
        with open(shard, "a", encoding="utf-8") as fh:
            fh.write(serialize_entry(entry) + "\n")
    except OSError as exc:
        _die(f"could not write shard {shard}: {exc}", EXIT_DOMAIN)

    # Commit with the agent identity so provenance holds on the shared branch.
    # Committer identity is set inline (see build_commit_args) so this works with
    # no ambient git identity configured and never mutates the global git config.
    rel = os.path.relpath(shard, _checkout_root())
    _git("add", rel)
    commit = _git(*build_commit_args(_agent_id(), kind, entry["id"]))
    if commit.returncode != 0:
        # Fail loud: the entry is appended to the shard but the commit that would
        # share it did not happen — never print the `recorded` success line, and
        # exit non-zero so a caller (including the autonomy-3 curator flow) can
        # detect the loss instead of believing the lesson was shared.
        _die(
            f'entry {entry["id"]} was NOT recorded: local commit failed — the '
            f"lesson was not shared: {commit.stderr.strip()}",
            EXIT_DOMAIN,
        )

    if not no_push:
        ok, detail = _push_via_orchestrator([entry])
        if not ok:
            sys.stderr.write(
                f"knowledge: recorded locally ({entry['id']}) but push failed: {detail}\n"
                "It will be shared on the next successful push.\n"
            )

    if as_json:
        print(serialize_entry(entry))
    else:
        print(entry["id"])
        sys.stderr.write(f'knowledge: recorded {kind} "{entry["text"]}" ({entry["id"]})\n')


def _kind_flag(argv):
    kind = None
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--kind":
            i += 1
            kind = argv[i] if i < len(argv) else None
        elif a.startswith("--kind="):
            kind = a[len("--kind="):]
        else:
            rest.append(a)
        i += 1
    if kind is not None and kind not in KINDS:
        _die("--kind must be one of " + "|".join(KINDS))
    return kind, rest


def cmd_search(argv):
    kind, rest = _kind_flag(argv)
    as_json = False
    no_sync = False
    limit = None
    query_parts = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--json":
            as_json = True
        elif a == "--no-sync":
            no_sync = True
        elif a == "--limit":
            i += 1
            limit = int(rest[i]) if i < len(rest) and rest[i].isdigit() else None
        elif a.startswith("--limit="):
            v = a[len("--limit="):]
            limit = int(v) if v.isdigit() else None
        elif a in ("--tier", "--source"):
            i += 1  # reserved; accepted and ignored in Phase 1
        else:
            query_parts.append(a)
        i += 1
    query = " ".join(query_parts).strip()
    if query == "":
        _die('search: usage: knowledge search "<query>" [--kind k] [--limit N] [--json] [--no-sync]')

    if not no_sync:
        _refresh_checkout()

    manifest = _load_manifest()
    pairs = _read_all_entries(manifest, kind)
    matched = match_entries(visible_entries([e for e, _ in pairs], now=_default_now()), query, kind)
    if limit is not None:
        matched = matched[:limit]

    if not matched:
        sys.stderr.write(f'knowledge: no matches for "{query}"\n')
        sys.exit(1)

    # #915: report the returned ids (after fold + limit) — never the query text.
    _post_retrieval("search", [e.get("id") for e in matched])

    for e in matched:
        if as_json:
            print(serialize_entry(e))
        else:
            conv = len(e.get("convergence") or [])
            print(f'[team] {e.get("text","")}  (id={e.get("id","?")} by={e.get("originAgent","?")} conv={conv})')


def cmd_list(argv):
    kind, rest = _kind_flag(argv)
    mine = "--mine" in rest
    as_json = "--json" in rest
    manifest = _load_manifest()
    pairs = _read_all_entries(manifest, kind)
    entries = visible_entries([e for e, _ in pairs], now=_default_now())
    if mine:
        entries = [e for e in entries if e.get("originAgent") == _agent_id()]
    # #915: a list is an explicit read too — same strong `search` signal.
    _post_retrieval("search", [e.get("id") for e in entries])
    for e in entries:
        if as_json:
            print(serialize_entry(e))
        else:
            print(f'{e.get("kind","?"):11} {e.get("text","")}  (id={e.get("id","?")} by={e.get("originAgent","?")})')


def cmd_path(argv):
    as_json = "--json" in argv
    pos = [a for a in argv if a != "--json"]
    if not pos:
        _die('path: usage: knowledge path "<id>" [--json]')
    wanted = pos[0]
    manifest = _load_manifest()
    for e, fpath in _read_all_entries(manifest):
        if e.get("id") == wanted:
            rel = os.path.relpath(fpath, _store_root())
            if as_json:
                print(json.dumps({"id": wanted, "path": rel}, ensure_ascii=False))
            else:
                print(rel)
            return
    sys.stderr.write(f'knowledge: no entry with id "{wanted}"\n')
    sys.exit(EXIT_DOMAIN)


def _agent_skills_root():
    """This agent's private skill pool (bottom rung of the skill ladder)."""
    explicit = os.environ.get("AGENT_SKILLS_DIR")
    if explicit:
        return explicit
    return os.path.join("/workspace/agents", _agent_id(), "skills")


def _write_agent_skill(skill):
    """Write a private agent-tier skill (SKILL.md + provenance.json) into this
    agent's own pool. Local only — no network: the agent owns its private tier,
    exactly as it owns memory/. Returns the destination dir."""
    dst = os.path.join(_agent_skills_root(), skill["name"])
    os.makedirs(dst, exist_ok=True)
    md = skill["skill_md"]
    if not md.endswith("\n"):
        md += "\n"
    with open(os.path.join(dst, "SKILL.md"), "w", encoding="utf-8") as fh:
        fh.write(md)
    with open(os.path.join(dst, "provenance.json"), "w", encoding="utf-8") as fh:
        json.dump(skill["provenance"], fh, indent=2)
    return dst


def _nominate_via_orchestrator(entry_id, note):
    """POST a promotion nomination for `entry_id` to the orchestrator."""
    base = (os.environ.get("ORCHESTRATOR_INTERNAL_URL")
            or os.environ.get("AEE_ORCHESTRATOR_URL")
            or "http://orchestrator:4002").rstrip("/")
    url = f"{base}/internal/agents/{_agent_id()}/knowledge/nominate"
    payload = json.dumps(build_nomination(entry_id, note, _agent_id())).encode("utf-8")
    req = urllib.request.Request(
        url, data=payload, method="POST",
        headers=internal_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return True, resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace") if exc.fp else str(exc)
        return False, f"HTTP {exc.code}: {detail}"
    except (urllib.error.URLError, OSError) as exc:
        return False, str(exc)


def cmd_promote(argv):
    """Nominate a KB entry for a team skill, or (--to agent) keep it as a private
    agent-tier skill.

    Default (team-ward): RAISES a suggestion card; a human confirms the actual
    promotion in Agent Studio (autonomy level 2). It never promotes to the
    team autonomously.

    `--to agent`: writes a PRIVATE skill into this agent's own pool right away (no
    human needed — the agent owns its private tier). Lift it to the team later
    (agent→team) from Agent Studio.
    """
    note = None
    to = None
    name = None
    as_json = False
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            as_json = True
        elif a == "--note":
            i += 1
            if i < len(argv):
                note = argv[i]
        elif a.startswith("--note="):
            note = a[len("--note="):]
        elif a == "--to":
            i += 1
            if i < len(argv):
                to = argv[i]
        elif a.startswith("--to="):
            to = a[len("--to="):]
        elif a == "--name":
            i += 1
            if i < len(argv):
                name = argv[i]
        elif a.startswith("--name="):
            name = a[len("--name="):]
        else:
            pos.append(a)
        i += 1
    if not pos:
        _die('promote: usage: knowledge promote <id> [--to agent] [--name X] [--note "why skill-worthy"] [--json]')
    entry_id = pos[0]

    # Resolve the entry from the synced KB.
    manifest = _load_manifest()
    entry = next((e for e, _ in _read_all_entries(manifest) if e.get("id") == entry_id), None)
    if entry is None:
        sys.stderr.write(f'knowledge: no entry with id "{entry_id}"\n')
        sys.exit(1)

    if to == "agent":
        try:
            skill = build_agent_skill(
                entry, name=name, agent_id=_agent_id(),
                team_id=_team_id(),
            )
        except ValueError as exc:
            _die(str(exc))
        dst = _write_agent_skill(skill)
        if as_json:
            print(json.dumps({"to": "agent", "name": skill["name"], "path": dst}, ensure_ascii=False))
        else:
            print(skill["name"])
        sys.stderr.write(
            f'knowledge: wrote private agent skill "{skill["name"]}" ({dst}); '
            "lift it to the team (agent→team) from Agent Studio when it is team-ready.\n"
        )
        return
    if to not in (None, "team"):
        _die(f"promote: unsupported --to '{to}' (use 'agent', or omit to nominate a team skill)")

    ok, detail = _nominate_via_orchestrator(entry_id, note)
    if not ok:
        _die(f"nomination failed: {detail}", EXIT_DOMAIN)
    try:
        cand = json.loads(detail).get("candidate", {})
    except (json.JSONDecodeError, ValueError):
        cand = {}
    cid = cand.get("id", "?")
    if as_json:
        print(json.dumps({"to": "team", "nominated": entry_id, "candidate": cid}, ensure_ascii=False))
    else:
        print(cid)
    sys.stderr.write(
        f"knowledge: nominated {entry_id} for promotion (suggestion {cid}); "
        "a human confirms in Agent Studio.\n"
    )


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return
    cmd, rest = sys.argv[1], sys.argv[2:]
    dispatch = {
        "add": cmd_add,
        "search": cmd_search,
        "list": cmd_list,
        "path": cmd_path,
        "promote": cmd_promote,
    }
    fn = dispatch.get(cmd)
    if not fn:
        sys.stderr.write(
            f"knowledge: unknown subcommand '{cmd}'. "
            "Supported: add, search, list, path, promote.\n"
        )
        sys.exit(2)
    fn(rest)


if __name__ == "__main__":
    main()
