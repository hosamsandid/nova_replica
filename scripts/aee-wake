#!/usr/bin/env python3
"""aee-wake — hand off directly to another agent on your team (#2030).

Why: sometimes there is nothing to label. You are done, a specific teammate is
next, and you have one sentence of context for them — but a label hand-off
needs a routing label you have to invent AND an issue or PR to hang it on. A
`wakeAgent` outcome has neither: the orchestrator delivers the wake straight
into that agent's durable queue, inside the platform.

    aee-wake --to code-reviewer
    aee-wake --to code-reviewer --note "Look closely at the migration in step 3."

There is no fallback. Do not set a label instead — no label on this edge wakes
a `wake-agent` listener, and a manually applied one is pure decoration. Nothing
on GitHub will show that the hand-off did or did not happen; the platform's own
event log is the audit trail.

`--to` names a role WIRED to you in the flow, on your own team. Reaching nobody
is not an ambiguous outcome, it is a wiring bug — so unlike a label hand-off
(where a label also has standalone value as a status marker even when nobody
listens) this tool fails LOUD: an unknown target, a target outside your
team, or yourself all exit 1. Surface that to the user instead of retrying or
picking a different target.

`--note` is optional and capped at 1024 characters (longer is truncated with a
marker, not rejected). It reaches your teammate as UNTRUSTED CONTEXT wrapped in
an envelope, never as their instruction — they run their own configured wake
instruction. So write context, not commands: imperative prose in a note is
explicitly not honoured.

Delivery is pull-only: the target polls every 5 seconds, so the hand-off lands
within ~5s — and it stays queued (never dropped) while the target is disabled,
down, in maintenance mode, or holding the workspace for a loop.

Pass --json on any invocation for a single machine-readable result object on
stdout instead of the human lines.

Exit codes (shared CLI contract, docs/cli-contract.md): 0 ok · 1 domain error
(orchestrator reachable but REJECTED the wake — unknown/self/cross-team target)
· 2 usage error · 3 orchestrator unreachable (the hand-off was NOT delivered).
"""

import json
import os
import sys
import urllib.error
import urllib.request

ORCH = (os.environ.get("ORCHESTRATOR_INTERNAL_URL")
        or os.environ.get("AEE_ORCHESTRATOR_URL")
        or "http://orchestrator:4002").rstrip("/")
TIMEOUT_SEC = 20


# Internal-API credential (#1456, GOV-PLATFORM-2). `startAgentProcess` bakes a
# per-agent token into the container env, exactly like the GitHub PAT; it is
# valid only for the agent-facing allowlist and only for this agent's own id.
# Absent — a stack that has not armed the gate — the call goes out
# unauthenticated and the orchestrator behaves exactly as it did before.
# Duplicated across the agent-side CLIs on purpose: each is a dependency-free
# single file by contract (docs/cli-contract.md §4.5), so there is nowhere
# shared to put it.
def internal_headers(extra=None):
    headers = dict(extra or {})
    token = os.environ.get("AEE_INTERNAL_TOKEN")
    if token:
        headers["Authorization"] = "Bearer " + token
    return headers

# Shared CLI-contract exit codes (docs/cli-contract.md).
EXIT_OK = 0
EXIT_DOMAIN = 1
EXIT_USAGE = 2
EXIT_UNREACHABLE = 3

# Kept in step with WAKE_NOTE_MAX in orchestrator/wake-agent.js. The server
# re-clamps regardless — this is so `--json` reports the note that was actually
# sent, not a longer one the caller believes it sent.
NOTE_MAX = 1024
NOTE_TRUNCATION_MARK = " […truncated]"

# Why each refusal happened, in the producer's own terms. The orchestrator
# returns a machine reason; the agent reading this needs to know it is a WIRING
# problem it must report, not a transient failure to retry.
REFUSAL_HELP = {
    "unknown-target": ("no agent with that id exists — check the role id in "
                       "your Outcomes block against the flow's wiring"),
    "cross-team": ("that agent is on a different team — a direct hand-off is "
                   "same-team only, by design"),
    "self-target": "that is you — a hand-off cannot target its own role",
    "no-team": ("your team could not be resolved on one of the two ends, so "
                "the same-team check cannot pass"),
}

_FLAGS = {"--to", "--note", "--json"}

_AS_JSON = False


def die(msg: str, code: int = EXIT_USAGE):
    if _AS_JSON:
        sys.stdout.write(json.dumps({"ok": False, "error": msg}) + "\n")
    else:
        sys.stderr.write(f"aee-wake: {msg}\n")
    sys.exit(code)


def usage():
    die("usage: aee-wake --to <roleId> [--note \"<one sentence of context>\"] [--json]")


def clamp_note(note: str) -> str:
    if len(note) <= NOTE_MAX:
        return note
    return note[: NOTE_MAX - len(NOTE_TRUNCATION_MARK)] + NOTE_TRUNCATION_MARK


def main(argv: list[str]):
    global _AS_JSON
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return
    to = None
    note = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            _AS_JSON = True
        elif a == "--to":
            if to is not None:
                die("pass --to exactly once")
            i += 1
            # One of THIS tool's own flags in the value slot means the value was
            # forgotten. Swallowing it would POST `toAgentId: "--json"` and
            # report a 404 wiring problem for what is really a usage error.
            # Only the known flags are rejected, not everything starting with
            # `-`, so a note may legitimately begin with a dash.
            if i >= len(argv) or argv[i] in _FLAGS:
                usage()
            to = argv[i]
        elif a == "--note":
            if note is not None:
                die("pass --note at most once")
            i += 1
            if i >= len(argv) or argv[i] in _FLAGS:
                usage()
            note = argv[i]
        else:
            usage()
        i += 1

    if not to or not to.strip():
        usage()
    to = to.strip()
    agent_id = os.environ.get("AGENT_ID")
    if not agent_id:
        die("AGENT_ID is not set in the environment")

    payload = {"fromAgentId": agent_id, "toAgentId": to}
    sent_note = None
    if note is not None and note.strip():
        sent_note = clamp_note(note.strip())
        payload["note"] = sent_note

    req = urllib.request.Request(
        f"{ORCH}/internal/wake-agent",
        data=json.dumps(payload).encode("utf-8"),
        headers=internal_headers({"Content-Type": "application/json"}),
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raw = ""
        try:
            raw = exc.read().decode("utf-8", "replace")[:300]
        except Exception:
            pass
        reason = None
        try:
            reason = (json.loads(raw) or {}).get("reason")
        except Exception:
            pass
        if exc.code >= 500:
            # The orchestrator was reached but FAILED, it did not refuse: the
            # hand-off did not happen and the cause may be transient. Reporting
            # this as a wiring problem ("do not retry") would tell the producer
            # to give up on a delivery that might well succeed. Exit 3 — the
            # contract's "backend did not carry it out" code — not 1.
            die(f"the orchestrator FAILED to deliver the hand-off to '{to}' "
                f"(HTTP {exc.code}): {raw or 'no detail'}. The hand-off was NOT "
                f"delivered. This may be transient — surface it to the user; do "
                f"not set a label instead, no label wakes this edge.",
                EXIT_UNREACHABLE)
        # 400 is a malformed request (our bug or a bad argument); 403/404 are
        # the flow-graph refusals. Both are domain errors — the orchestrator was
        # reached and said no — so both exit 1 and neither is retryable.
        detail = REFUSAL_HELP.get(reason) or raw or f"HTTP {exc.code}"
        die(f"the orchestrator REFUSED the hand-off to '{to}': {detail}. "
            f"This is a wiring problem, not a transient failure — do not retry "
            f"and do not set a label instead. Surface it to the user.",
            EXIT_DOMAIN)
    except Exception as exc:
        die(f"could not reach the orchestrator at {ORCH} — the hand-off was "
            f"NOT delivered ({exc}). Do not fall back to setting a label; "
            f"there is no label on this edge and nothing would be woken.",
            EXIT_UNREACHABLE)

    target = data.get("target") or to
    if _AS_JSON:
        sys.stdout.write(json.dumps({
            "ok": True,
            "target": target,
            **({"note": sent_note} if sent_note else {}),
            "truncated": bool(sent_note and sent_note.endswith(NOTE_TRUNCATION_MARK)),
        }) + "\n")
        return
    print(f"aee-wake: handed off to {target} — it will pick this up within ~5s.")
    if sent_note and sent_note.endswith(NOTE_TRUNCATION_MARK):
        sys.stderr.write(
            f"aee-wake: note — your note exceeded {NOTE_MAX} characters and was "
            f"truncated. Keep a hand-off note to a sentence or two.\n")


if __name__ == "__main__":
    main(sys.argv[1:])
